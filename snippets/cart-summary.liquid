{%- doc -%}
  Renders the cart summary totals.

  @param {string} [accelerated_checkout_buttons_layout] - { 'vertical' } Forced layout of the additional checkout buttons, instead of relying on platform's layout.
  @param {string} [section_id] - The section ID for cart discount component.
  @param {boolean} [is_drawer] - When true (cart drawer only), renders the delivery-date estimate above the checkout button and a trust message below it.
{%- enddoc -%}

{% render 'text-component-shimmer-styles' %}
{% render 'cart-typography-styles' %}

<div class="cart-totals">
  {% # We need to keep this node in place to allow morphing to work properly # %}
  <div class="cart-totals__original-container cart-primary-typography">

    {%- if cart.cart_level_discount_applications.size > 0 -%}
      <span class="cart-totals__item cart-totals__original">
        <span class="cart-totals__original-label">{{ 'content.cart_subtotal' | t }}</span>
        <span
          class="cart-totals__original-value cart-secondary-typography"
          data-testid="cart-subtotal-value"
        >
          {{- cart.items_subtotal_price | money -}}
        </span>
      </span>
      <ul
        class="cart-discounts"
        role="list"
        aria-label="{{ 'content.discounts' | t }}"
      >
        {%- for discount in cart.cart_level_discount_applications -%}
          <li class="cart-discounts__item">
            <span class="cart-discounts__label">
              {{- 'icon-discount.svg' | inline_asset_content -}}
              {{ discount.title | escape }}
            </span>
            <span class="cart-discounts__value cart-secondary-typography"
              >-{{ discount.total_allocated_amount | money -}}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  {% if settings.show_cart_note or settings.show_add_discount_code %}
    <div class="cart-actions">
      {% if settings.show_cart_note %}
        <script
          type="module"
          src="{{ 'cart-note.js' | asset_url }}"
        ></script>

        <cart-note style="display: flex;">
          {% capture cart_note_accordion_children %}
            <details
              {% if settings.cart_note_open_by_default %}
                open
              {% endif %}
            >
              <summary class="cart-note__summary">
                <span class="cart-note__label cart-primary-typography">
                  {{ 'content.seller_note' | t }}
                </span>

                <span class="cart-totals__icon cart-totals__icon--toggle">
                  <span class="cart-totals__icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
                  <span class="cart-totals__icon-minus">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
                </span>
              </summary>

              <div class="details-content cart-note__inner">
                <label
                  for="cart-note"
                  class="visually-hidden"
                >
                  {{- 'content.seller_note' | t -}}
                </label>
                <textarea
                  form="cart-form"
                  on:input="/updateCartNote"
                  id="cart-note"
                  class="cart-note__instructions"
                  name="note"
                  data-skip-node-update
                >{{ cart.note }}</textarea>
              </div>
            </details>
          {% endcapture %}
          {% render 'accordion-custom-component',
            children: cart_note_accordion_children,
            class: 'cart-note',
            open_by_default_on_desktop: settings.cart_note_open_by_default,
            open_by_default_on_mobile: settings.cart_note_open_by_default
          %}
        </cart-note>
      {% endif %}
      {% if settings.show_cart_note and settings.show_add_discount_code %}
        <div class="cart-actions__divider"></div>
      {% endif %}
      {% if settings.show_add_discount_code %}
        {% liquid
          assign discount_codes = cart.cart_level_discount_applications | where: 'type', 'discount_code' | map: 'title'
          for item in cart.items
            for allocation in item.line_level_discount_allocations
              if allocation.discount_application.type == 'discount_code'
                assign discount_codes = item.line_level_discount_allocations | slice: forloop.index0 | map: 'discount_application' | map: 'title' | concat: discount_codes
              endif
            endfor
          endfor

          assign discount_codes = discount_codes | uniq

          # Evaluate the boolean expression for the disclosure state
          if discount_codes.size == 0
            assign disclosure_expanded = false
          else
            assign disclosure_expanded = true
          endif
        %}

        {% capture cart_discount_accordion_children %}
          <details
            {% if disclosure_expanded %}
              open
            {% endif %}
          >
            <summary class="cart-discount__summary">
              <span class="cart-discount__label cart-primary-typography">
                <span class="svg-wrapper cart-discount__label-icon">
                  {{- 'icon-discount.svg' | inline_asset_content -}}
                </span>
                {{ 'content.discount' | t }}
              </span>

              <span class="cart-totals__icon cart-totals__icon--toggle">
                <span class="cart-totals__icon-plus">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
                <span class="cart-totals__icon-minus">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
              </span>
            </summary>

            <div class="details-content">
              <div id="cart-discount-disclosure">
                <cart-discount-component
                  {% if section_id != blank %}
                    data-section-id="{{ section_id }}"
                  {% endif %}
                >
                  <div class="cart-discount__content">
                    <form
                      on:submit="/applyDiscount"
                      onsubmit="return false;"
                      class="cart-discount__form"
                    >
                      <label
                        for="cart-discount"
                        class="visually-hidden"
                      >
                        {{- 'accessibility.discount' | t -}}
                      </label>
                      <input
                        id="cart-discount"
                        class="cart-discount__input"
                        type="text"
                        name="discount"
                        size="8"
                        placeholder="{{ 'content.discount_code' | t }}"
                        required
                        data-skip-node-update
                      >
                      <button
                        type="submit"
                        class="button cart-discount__button"
                      >
                        {{ 'actions.apply' | t }}
                      </button>
                    </form>
                  </div>
                  <div
                    class="cart-discount__error hidden"
                    role="alert"
                    ref="cartDiscountError"
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    <small
                      class="cart-discount__error-text cart-primary-typography hidden"
                      ref="cartDiscountErrorDiscountCode"
                    >
                      {{ 'content.discount_code_error' | t: code: 'test' }}
                    </small>
                    <small
                      class="cart-discount__error-text cart-primary-typography hidden"
                      ref="cartDiscountErrorShipping"
                    >
                      {{ 'content.shipping_discount_error' | t }}
                    </small>
                  </div>
                  <ul class="cart-discount__codes">
                    {% for discount_code in discount_codes %}
                      <li
                        class="cart-discount__pill"
                        data-discount-code="{{ discount_code }}"
                        aria-label="{{ 'accessibility.discount_applied' | t: code: discount_code }}"
                      >
                        <p class="cart-discount__pill-code">
                          {{ discount_code }}
                        </p>
                        <button
                          type="button"
                          on:click="/removeDiscount"
                          class="cart-discount__pill-remove svg-wrapper svg-wrapper--smaller button-unstyled"
                          aria-label="{{ 'actions.remove_discount' | t: code: discount_code }}"
                        >
                          {{- 'icon-filters-close.svg' | inline_asset_content -}}
                        </button>
                      </li>
                    {% endfor %}
                  </ul>
                </cart-discount-component>
              </div>
            </div>
          </details>
        {% endcapture %}
        {% render 'accordion-custom-component', children: cart_discount_accordion_children, class: 'cart-discount' %}
      {% endif %}
    </div>
  {% endif %}

  {%- liquid
    if settings.currency_code_enabled_cart_total
      assign total_price = cart.total_price | money_with_currency
    else
      assign total_price = cart.total_price | money
    endif
  -%}

  {% liquid

        assign compare_at_total = 0
        assign total_compare_at_savings = 0
        assign c_savings_percent = 0
        assign regular_price_total = 0
        assign discount_total = cart.total_discount
        assign total_subscription_savings_amount = 0
        assign total_subscription_discount_percentage = 0
        assign item_level_discount_percentage = 0

        for item in cart.items
          assign item_total_compare_price = 0
          assign quantity = item.quantity
          assign regular_price = item.variant.price
          assign compare_price = item.variant.compare_at_price
          assign item_total_regular_price = regular_price | times: quantity

          if compare_price and compare_price > regular_price
            assign item_total_compare_price = compare_price | times: quantity
          else
            assign item_total_compare_price = regular_price | times: quantity
          endif

          assign compare_at_total = compare_at_total | plus: item_total_compare_price
          assign regular_price_total = regular_price_total | plus: item_total_regular_price

          if compare_price and compare_price > regular_price
            assign single_item_save = compare_price | minus: regular_price
            assign line_item_save = single_item_save | times: quantity
            assign total_compare_at_savings = total_compare_at_savings | plus: line_item_save
          endif

          if item.line_level_discount_allocations.size > 0
            for discount in item.line_level_discount_allocations
              assign item_level_discount_percentage = item_level_discount_percentage | plus: discount.discount_application.value
            endfor
          endif

          if item.selling_plan_allocation != nil
            assign plan_price_per_unit = item.selling_plan_allocation.per_delivery_price

            if plan_price_per_unit < regular_price
              assign subscription_saving_per_unit = regular_price | minus: plan_price_per_unit
              assign subscription_line_saving = subscription_saving_per_unit | times: quantity
              assign total_subscription_savings_amount = total_subscription_savings_amount | plus: subscription_line_saving

              assign item_sub_discount_percent = subscription_saving_per_unit | times: 100.0 | divided_by: regular_price
              assign total_subscription_discount_percentage = total_subscription_discount_percentage | plus: item_sub_discount_percent
            endif
          endif

        endfor

        if compare_at_total > 0 and total_compare_at_savings > 0
          assign c_savings_percent = total_compare_at_savings | times: 100.0 | divided_by: compare_at_total
        endif

        assign cart_level_discount_percentage = 0
        for discount in cart.cart_level_discount_applications
          assign cart_level_discount_percentage = cart_level_discount_percentage | plus: discount.value
        endfor

        assign total_line_price = compare_at_total | minus: regular_price_total
        assign total_saved_amount = total_line_price | plus: discount_total | plus: total_subscription_savings_amount

        # Percentage saved off the ORIGINAL price (compare_at_total, i.e. the "Total Price"
        # shown), not off the amount paid. Dividing by cart.total_price (the discounted total)
        # overstates it — e.g. $11.99 off $79.99 is 15%, but 11.99 / 68.00 rounds to 18%.
        if compare_at_total > 0 and total_saved_amount > 0
          assign grand_saving = total_saved_amount | times: 100.0 | divided_by: compare_at_total | round
        else
          assign grand_saving = 0
        endif

      %}

     {%- if settings.show_cart_savings and total_saved_amount > 0 -%}
     <div id="cart-total-savings" class="cart-savings">
     <div class="cart-totals__item cart__summary-item cart__total summary-total-price-wrapper">
          <span class="cart__original-total-label">
            Total Price
          </span>
          <span class="summary-total-price" id="summary-total-price"> 
              {{ compare_at_total | money }}
          </span>
      </div>  
            <div class="cart-totals__item cart__summary-item cart__total summary-total-compare-wrapper" style="--cart-savings-color: {{ settings.cart_savings_color }};">
          <span class="cart__original-total-label dis-flex align-center gap-2xs">
            Discount <span id="grand-saving" class="grand-saving dis-flex align-center gap-2xs"> {{ 'icon-discount.svg' | inline_asset_content }} {{ grand_saving | append: '%' }}  </span>
          </span>
          <span class="summary-total-compare-price" id="summary-total-compare-price"> 
              -{{ total_saved_amount | money }}
          </span>
      </div>

     </div>
  {%- endif -%}

  <div id="cart-estimated-total" class="cart-totals__container{% if settings.show_installments %} cart-totals__container--has-installments{% endif %}">
    <span
      class="cart-totals__item cart-totals__total"
      role="status"
    >
      <span class="cart-totals__total-label cart-primary-typography">{{ 'content.cart_estimated_total' | t }}</span>
      <text-component
        ref="cartTotal"
        value="{{ total_price | strip_html }}"
        class="cart-totals__total-value cart-secondary-typography"
        {% comment %} Used by payment_terms web component {% endcomment %}
        data-testid="cart-total-value"
        data-cart-subtotal
      >
        {{ total_price }}
      </text-component>
    </span>
    {% if settings.show_installments %}
      <span class="cart-totals__item cart-totals__installments">
        {% form 'cart', cart %}
          {{ form | payment_terms }}
        {% endform %}
      </span>
    {% endif %}
    {% if settings.shipping_info %}
      <div class="cart-totals__item cart-totals__tax-note cart-primary-typography">
        {% render 'tax-info', has_discounts_enabled: settings.show_add_discount_code %}
      </div>
    {% endif %}
  </div>
</div>

{%- if is_drawer -%}
  {% render 'cart-delivery-date' %}
{%- endif -%}

<div class="cart__ctas">
  <button
    type="submit"
    id="checkout"
    class="cart__checkout-button button"
    name="checkout"
    {% if cart == empty %}
      disabled
    {% endif %}
    form="cart-form"
  >
    <span class="button-text">
      {{ 'content.checkout' | t }}
    </span>
  </button>

  {% if additional_checkout_buttons and settings.show_accelerated_checkout_buttons %}
    <div
      class="
        additional-checkout-buttons
        {% if accelerated_checkout_buttons_layout == 'vertical' %}additional-checkout-buttons--vertical{% endif %}
      "
    >
      {{ content_for_additional_checkout_buttons }}
    </div>
  {% endif %}
  {%- if is_drawer -%}
  <p class="cart-trust-message">{{ 'content.cart_trust_message' | t }}</p>
{%- endif -%}
</div>

{% stylesheet %}
  .cart-actions {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-block: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block: 0;
    margin-block-start: var(--margin-3xs);
  }

  .cart-actions__divider {
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
  }

  .cart-totals:not(:has(.cart-actions)) {
    margin-block-start: var(--margin-3xs);
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--margin-xl);
  }

  .cart-totals__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-totals__tax-note {
    color: var(--color-foreground-subdued);
  }

  .cart-totals__tax-note a {
    color: var(--color-foreground-subdued);
    text-decoration-line: underline;
    text-decoration-color: currentColor;

    &:hover {
      text-decoration-color: transparent;
    }
  }

  .cart-totals__tax-note small {
    font-size: var(--font-size--2xs);
  }

  .cart-discounts {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cart-discounts__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-discounts__label {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
  }

  .cart-discounts__label svg {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    display: inline-block;
  }

  .cart-totals__original-container,
  .cart-totals__container {
    display: flex;
    flex-direction: column;
  }

  .cart-totals__container {
    row-gap: var(--gap-2xs);

    &.cart-totals__container--has-installments {
      row-gap: var(--gap-2xs);
    }
  }

  .cart-totals__original-container:empty {
    display: none;
  }

  .cart-totals {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    width: 100%;
    border-block-start: none;

    &:has(> :first-child:not(.cart-totals__original-container, .cart-totals__container)) {
      padding-block-start: 0;
      border-block-start: none;
    }

    @media screen and (min-width: 750px) {
      padding-block-start: 0;
    }
  }

  .cart-totals__original-container,
  .cart-totals__original-container * {
    font-size: var(--cart-font-size--sm);
  }

  .cart-totals__total {
    align-items: baseline;
    font-weight: var(--font-weight-bold);
  }

  .cart-totals__total-label {
    font-size: var(--cart-font-size--sm);
  }

  .cart-totals__total-value {
    font-size: var(--cart-font-size--xl);

    @media screen and (max-width: 749px) {
      font-size: var(--font-size--lg);
    }
  }

  .cart-totals__installments {
    color: var(--color-foreground);
    font-size: var(--font-size--2xs);
  }

  .cart-note {
    width: 100%;
  }

  @starting-style {
    .cart-note[open-by-default-on-desktop][open-by-default-on-mobile] .details-content {
      block-size: auto;
      opacity: 1;
      overflow-y: visible;
    }
  }

  .cart-note__inner {
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  .cart-note__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-note__summary:hover {
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .cart-note__label {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-2xs);
    font-size: var(--font-size--2xs);
    font-weight: 500;
  }

  .cart-note__instructions {
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    border-width: var(--style-border-width-inputs);
    border-color: var(--color-input-border);
    transition: box-shadow var(--animation-speed) ease;
    box-shadow: var(--input-box-shadow);
    min-height: 5.5rem;
    min-width: 100%;
    max-width: 100%;
    font-size: var(--font-size--sm);
    padding: max(4px, calc(var(--style-border-radius-inputs) * (1 - cos(45deg))));
  }

  .cart-totals__icon {
    height: var(--icon-size-xs);
    width: var(--icon-size-xs);
    margin: 0;
  }

  /* "Shop with confidence" trust line below the cart drawer checkout button. */
  .cart-trust-message {
    margin: 0;
    text-align: center;
    font-size: var(--font-size--xs);
    color: #285a46;
  }

  /* Plus/minus toggle: show plus when the accordion is closed, minus when open. */
  .cart-totals__icon--toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .cart-totals__icon-plus,
  .cart-totals__icon-minus {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  details[open] > summary .cart-totals__icon-plus {
    display: none;
  }

  details:not([open]) > summary .cart-totals__icon-minus {
    display: none;
  }

  /* Tag icon before the "Discount" label. */
  .cart-discount__summary .cart-discount__label {
    align-items: center;
  }

  .cart-discount__label-icon {
    display: inline-flex;
    flex-shrink: 0;
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
  }

  .cart-discount__label-icon svg {
    width: 100%;
    height: 100%;
  }

  .cart__ctas {
    width: 100%;
    display: grid;
    gap: var(--checkout-button-gap);
    grid-auto-flow: row;
    grid-template-columns: 1fr;
  }

  .cart__ctas .cart__checkout-button {
    width: 100%;
    height: clamp(25px, var(--height-buy-buttons), 55px);
    padding-inline: var(--padding-4xl);
  }

  .cart-drawer__summary .cart-totals:not(:has(.cart-totals__original-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-discount__input {
    background-color: var(--color-input-background);
    color: var(--color-input-text);
    border-width: var(--style-border-width-inputs);
    border-color: var(--color-input-border);
    border-style: solid;
    border-radius: var(--style-border-radius-inputs);
    padding: var(--padding-sm) var(--padding-md);
    height: 100%;
    flex-grow: 1;
    min-width: 0;
    font-size: var(--font-size--sm);
  }

  .cart-discount__input::placeholder {
    color: rgb(var(--color-input-text-rgb) / var(--opacity-subdued-text));
  }

  .cart-discount__pill-code {
    overflow: hidden;
    max-width: 100px;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0;
  }

  .cart-discount {
    width: 100%;
  }

  .cart-discount__codes {
    display: none;
    gap: var(--padding-xs);
    flex-wrap: wrap;
    list-style: none;
    padding-inline: 0;
    margin: 0;
  }

  .cart-discount__codes:has(.cart-discount__pill) {
    display: flex;
  }

  .cart-discount__button {
    height: 100%;
  }

  .cart-discount__content {
    height: calc(var(--button-size) + var(--padding-2xs) + var(--padding-sm));
  }

  .cart-discount__pill {
    display: flex;
    color: var(--color-foreground);
    gap: var(--padding-xs);
    align-items: center;
    padding: var(--padding-xs) var(--padding-sm);
    border-radius: var(--style-border-radius-pills);
    background-color: var(--color-input-background);
    text-transform: uppercase;
  }

  .cart-discount__form {
    display: flex;
    gap: var(--padding-md);
    align-items: center;
    height: 100%;
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  :is(.cart-discount__pill-remove, .cart-discount__pill-remove:hover) {
    --close-icon-opacity: 0.4;

    color: var(--color-foreground);
    background-color: transparent;
    pointer-events: all;
    cursor: pointer;
    height: 100%;
  }

  .cart-discount__error {
    display: flex;
    align-items: center;
    width: 100%;
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  .cart-discount__error .svg-wrapper {
    flex-shrink: 0;
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    margin-inline: var(--margin-3xs) var(--margin-xs);
  }

  .cart-discount__error-text {
    margin-block-start: var(--margin-3xs);
  }

  .cart-discount__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-discount__summary:hover {
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .cart-discount__label {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-2xs);
    font-size: var(--font-size--2xs);
    font-weight: 500;
  }

  /* Total Price / Discount savings rows (Settings → Cart → "Show Total Price and Discount").
     Styled to match the highlighted inline design: a green "Discount" row with a bordered
     tag + percentage badge. Uses scoped rules rather than the theme's non-existent
     dis-flex/align-center utility classes the markup references. */

  /* Keyed wrapper (stable id) so the cart re-render/morph can cleanly add or remove the whole
     block without cross-matching the estimated-total container. display:contents keeps the two
     rows laid out exactly as direct children of .cart-totals. */
  .cart-savings {
    display: contents;
  }

  .summary-total-price-wrapper,
  .summary-total-compare-wrapper {
    font-size: var(--cart-font-size--sm);
  }

  .summary-total-compare-wrapper {
    color: var(--cart-savings-color, #34a853);
    font-weight: 500;
  }

  .summary-total-compare-wrapper .cart__original-total-label {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
  }

  #grand-saving {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-3xs, 4px);
    font-size: var(--font-size--2xs);
    line-height: 1;
    color: var(--cart-savings-color, #34a853);
    border: 1px solid var(--cart-savings-color, #34a853);
    border-radius: var(--style-border-radius-buttons-secondary, 4px);
    padding: 3px 5px;
  }

  #grand-saving svg {
    width: 12px;
    height: 12px;
  }

  @media screen and (min-width: 750px) {
    .cart-summary--extend {
      height: 100%;
    }
  }
{% endstylesheet %}
