{{ 'overflow-list.css' | asset_url | preload_tag: as: 'style' }}
{{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
{% comment %} {{ 'base-extended.css' | asset_url | stylesheet_tag: preload: true }} {% endcomment %}

<link rel="preload" href="{{ 'base-extended.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript>{{ 'base-extended.css' | asset_url | stylesheet_tag }}</noscript>


{% if request.page_type == "index" %}
<link href="{{ 'homepage.css' | asset_url }}" as="style" rel="preload">
<link rel="stylesheet"
    href="{{ 'homepage.css' | asset_url }}"
    media="print"
    onload="this.media='all'">
<noscript>
    <link href="{{ 'homepage.css' | asset_url }}" rel="stylesheet" type="text/css" media="all" />
</noscript> 
{% endif %}

{% if request.page_type == "product" %}
<link href="{{ 'product-page.css' | asset_url }}" as="style" rel="preload">
<link rel="stylesheet"
    href="{{ 'product-page.css' | asset_url }}"
    media="print"
    onload="this.media='all'">
<noscript>
    <link href="{{ 'product-page.css' | asset_url }}" rel="stylesheet" type="text/css" media="all" />
</noscript> 
{% endif %}

{% if request.page_type == "page" and template.suffix == 'about-us' %}
<link href="{{ 'about-us-page.css' | asset_url }}" as="style" rel="preload">
<link rel="stylesheet"
    href="{{ 'about-us-page.css' | asset_url }}"
    media="print"
    onload="this.media='all'">
<noscript>
    <link href="{{ 'about-us-page.css' | asset_url }}" rel="stylesheet" type="text/css" media="all" />
</noscript> 
{% endif %}

{% if request.page_type == "page" and template.suffix == 'affiliate' or template.suffix contains 'vaporizer-guide' %}
<link href="{{ 'affiliate-page.css' | asset_url }}" as="style" rel="preload">
<link rel="stylesheet"
    href="{{ 'affiliate-page.css' | asset_url }}"
    media="print"
    onload="this.media='all'">
<noscript>
    <link href="{{ 'affiliate-page.css' | asset_url }}" rel="stylesheet" type="text/css" media="all" />
</noscript> 
{% endif %}