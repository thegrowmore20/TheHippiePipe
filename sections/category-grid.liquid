{% liquid
  assign has_background = false
  if section.settings.background_color != blank
    assign has_background = true
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign ratio = section.settings.card_aspect_ratio
%}

<div class="section-background{% if has_background %} color-custom-{{ section.id }}{% endif %}"></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    {% if has_background %}color-custom-{{ section.id }}{% endif %}
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
  data-testid="category-grid"
>
  {%- comment -%}
    A static group above the grid, so heading/subheading blocks land here instead of
    becoming grid cells. Hidden by base.css when the group has no children.
  {%- endcomment -%}
  <div class="section-resource-list__header category-grid__header">
    {% content_for 'block', type: 'group', id: 'static-header' %}
  </div>

  <div
    class="category-grid{% unless ratio == 'adapt' %} category-grid--fixed-ratio{% endunless %}"
    style="
      --category-grid-columns: {{ section.settings.columns }};
      --category-grid-columns-mobile: {{ section.settings.mobile_columns }};
      --category-grid-column-gap: {{ section.settings.columns_gap }}px;
      --category-grid-row-gap: {{ section.settings.rows_gap }}px;
      {%- unless ratio == 'adapt' %} --category-grid-card-ratio: {{ ratio }};{% endunless -%}
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  /* Mobile-first, matching the theme's 750px desktop breakpoint. */
  .category-grid {
    display: grid;
    grid-template-columns: repeat(var(--category-grid-columns-mobile, 2), minmax(0, 1fr));
    column-gap: var(--category-grid-column-gap, 12px);
    row-gap: var(--category-grid-row-gap, 12px);
  }

  @media screen and (min-width: 750px) {
    .category-grid {
      grid-template-columns: repeat(var(--category-grid-columns, 3), minmax(0, 1fr));
    }
  }

  /* Grid items default to min-width: auto, which lets a long title widen its whole column. */
  .category-grid > * {
    min-width: 0;
  }

  /* The background image is absolutely positioned, so the card clips it to its own radius. */
  .category-grid > .group-block {
    overflow: clip;
  }

  /* Outranks .group-block--height-fit/fill so the ratio sets the height, not the text inside. */
  .category-grid--fixed-ratio > .group-block {
    aspect-ratio: var(--category-grid-card-ratio);
    height: auto;
  }
{% endstylesheet %}

