{%- doc -%}
  Aplus comparison — Horizon-structured section (converted from a theme block).

  Renders a product comparison table with a sticky attribute column and drag-to-scroll.

  Data-driven mode (preferred): reads a features metaobject list (one entry per row) and a
  product-reference list (the columns). Each feature entry holds one field per product,
  keyed by that product's compare-key metafield — falling back to the product handle with
  dashes turned into underscores.

  Manual mode (optional): a pipe-delimited table typed into section settings, for products
  that have no metafield data. Off by default and empty by default.

  ---------------------------------------------------------------------------
  CONVERSION NOTES (block -> section)
  ---------------------------------------------------------------------------
   - Outer shell is Horizon default: content is captured into `children` and handed to the
     `section` snippet, so background media, overlay, borders, width, height, padding,
     margin and contrast-override all behave natively.
   - Heading moved from the `_heading` THEME BLOCK to SECTION SETTINGS, with full
     type-preset, font, per-device size, alignment, padding and margin controls.
     `{% content_for 'block' %}` is gone; the section declares no blocks.
   - Metafield sources moved out of hardcoded Liquid into section settings: one shared
     namespace plus three keys (features, products, compare key). Resolution logic is
     otherwise unchanged.
   - Padding moved to the Horizon wrapper. The inner `spacing-style` render was removed so
     padding is not applied twice — `spacing-style` on Horizon's content wrapper reads the
     same four padding-* ids, so merchants keep all four controls.
   - Inner DOM and class names are unchanged, so existing custom CSS still matches.
   - The table border colour setting is `table_border_color`. `border_color` is reserved
     for Horizon's own section outline, which `border-override` reads by that exact id.

  ---------------------------------------------------------------------------
  NOTHING IS BRAND-SPECIFIC
  ---------------------------------------------------------------------------
   The block hardcoded one brand's comparison rows, two externally hosted product stills,
   a brand-specific footnote, and forced all of it on for a single product handle. All of
   it is gone. Every default in this section is empty or neutral, so the file is safe to
   drop onto any store without carrying another client's content with it.

  ---------------------------------------------------------------------------
  RENDER GUARDS
  ---------------------------------------------------------------------------
   1. The `hidden`-class approach is gone. The block used to BUILD the whole table —
      resource cards, images, every row — and then hide it with CSS when there were no
      comparison products. Now the data is resolved first and nothing is emitted at all.
      Exception: `request.design_mode` renders a placeholder naming the exact failure, so
      the section stays selectable in the editor. Never runs on the storefront.
   2. Metafield mode needs BOTH at least one usable feature row AND at least one
      comparison column that is not the current product. A table whose only column is the
      product you are already looking at is not a comparison, so it counts as no data.
   3. Feature rows with a blank name are skipped rather than rendered as an empty header.
   4. Manual mode needs to be enabled AND to have rows typed into it.
   5. Footnote, heading and heading CSS each render only when non-blank.
{%- enddoc -%}

{%- liquid
  assign uid = section.id | replace: '_', '' | replace: '-', '' | downcase
  assign s = section.settings

  assign heading_tag = s.heading_tag | default: 'h2'
  assign heading_text = s.heading | strip
  assign has_heading = false
  if heading_text != blank
    assign has_heading = true
  endif

  # ---------------------------------------------------------------- sources
  assign ns = s.metafield_namespace | default: 'custom'
  assign features_key = s.features_key | default: 'comparison_features'
  assign products_key = s.products_key | default: 'comparison_products'
  assign compare_key_key = s.compare_key_key | default: 'compare_key'

  assign features = product.metafields[ns][features_key].value
  assign compare_products = product.metafields[ns][products_key].value

  assign current_key = product.metafields[ns][compare_key_key].value | handle | replace: '-', '_'
  if current_key == blank
    assign current_key = product.handle | replace: '-', '_'
  endif

  # ------------------------------------------------------------ column count
  # Only columns that are not the current product count. One-column tables are
  # not comparisons, so they are treated as no data.
  assign other_columns = 0
  if compare_products != blank
    for cp in compare_products
      unless cp.id == product.id
        assign other_columns = other_columns | plus: 1
      endunless
    endfor
  endif

  # -------------------------------------------------------------- row count
  # A feature row with no name renders a blank sticky header, so it is skipped.
  assign valid_features = 0
  if features != blank
    for entry in features
      assign fname = entry.feature_name.value | default: entry.feature_name | strip_html | strip
      if fname != blank
        assign valid_features = valid_features | plus: 1
      endif
    endfor
  endif

  assign has_data = false
  if valid_features > 0 and other_columns > 0
    assign has_data = true
  endif

  # ----------------------------------------------------------- manual mode
  # When "Manual product handles" is filled in, only those handles use manual mode, and
  # they use it even when they have metafield data. Left empty, any product without
  # metafield data falls back to manual rows.
  assign handle_forced = false
  if s.manual_handles != blank
    assign forced_handles = s.manual_handles | replace: ' ', '' | downcase | split: ','
    for h in forced_handles
      if h != blank and h == product.handle
        assign handle_forced = true
      endif
    endfor
  endif

  assign use_metafields = false
  if has_data and handle_forced == false
    assign use_metafields = true
  endif

  assign manual_rows = ''
  if s.manual_rows != blank
    assign manual_rows = s.manual_rows | strip | newline_to_br | split: '<br />'
  endif

  assign use_manual = false
  if use_metafields == false and s.enable_manual and manual_rows != blank and manual_rows.size > 0
    if handle_forced
      assign use_manual = true
    elsif s.manual_handles == blank
      assign use_manual = true
    endif
  endif

  assign render_table = false
  if use_metafields or use_manual
    assign render_table = true
  endif

  # Track the real column width so srcset picks a correctly sized file. The block
  # hardcoded 230px here and ignored the column_width setting.
  assign card_sizes = '(min-width: 750px) ' | append: s.column_width | append: 'px, 200px'
-%}

{%- if render_table -%}

  {%- if has_heading -%}
    {% style %}
      .comparison-heading-{{ uid }} {
        display: block;
        margin: 0;
        width: {{ s.heading_width }};
        margin-block-start: {{ s.heading_margin_top }}px;
        margin-block-end: {{ s.heading_margin_bottom }}px;
        padding-block-start: {{ s.heading_padding_block_start }}px;
        padding-block-end: {{ s.heading_padding_block_end }}px;
        padding-inline-start: {{ s.heading_padding_inline_start }}px;
        padding-inline-end: {{ s.heading_padding_inline_end }}px;
        text-align: {{ s.heading_alignment }};
        text-wrap: pretty;
        font-family: {{ s.heading_font }};
        {% if s.heading_case != 'none' %}
          text-transform: {{ s.heading_case }};
        {% endif %}
        {% if s.heading_font_size > 0 %}
          font-size: {{ s.heading_font_size }}px;
        {% endif %}
        {% if s.heading_line_height > 0 %}
          line-height: {{ s.heading_line_height }};
        {% endif %}
        {% if s.heading_letter_spacing != 0 %}
          letter-spacing: {{ s.heading_letter_spacing }}px;
        {% endif %}
        {% if s.heading_color != blank %}
          color: {{ s.heading_color }};
        {% endif %}
      }

      {% if s.heading_max_width == 'narrow' %}
        .comparison-heading-{{ uid }} { max-width: 45ch; }
      {% elsif s.heading_max_width == 'normal' %}
        .comparison-heading-{{ uid }} { max-width: 75ch; }
      {% endif %}

      {% if s.heading_alignment == 'center' %}
        .comparison-heading-{{ uid }} { margin-inline: auto; }
      {% elsif s.heading_alignment == 'right' %}
        .comparison-heading-{{ uid }} { margin-inline-start: auto; }
      {% endif %}

      @media screen and (max-width: 749px) {
        .comparison-heading-{{ uid }} {
          text-align: {{ s.heading_alignment_mobile }};
          {% if s.heading_font_size_mobile > 0 %}
            font-size: {{ s.heading_font_size_mobile }}px;
          {% endif %}
          {% if s.heading_alignment_mobile == 'center' %}
            margin-inline: auto;
          {% elsif s.heading_alignment_mobile == 'right' %}
            margin-inline-start: auto;
            margin-inline-end: 0;
          {% else %}
            margin-inline-start: 0;
            margin-inline-end: auto;
          {% endif %}
        }
      }
    {% endstyle %}
  {%- endif -%}

  {%- capture children -%}
    <comparison-table
      class="comparison{% unless use_metafields %} comparison--manual{% endunless %}"
      style="
        --comparison-border: {{ s.table_border_color }};
        --comparison-attribute-background: {{ s.attribute_background }};
        --comparison-column-width: {{ s.column_width }}px;
        --comparison-radius: {{ s.corner_radius }}px;
      "
    >
      {%- if has_heading -%}
        <{{ heading_tag }} class="comparison-heading-{{ uid }} {{ s.heading_type_preset }}">
          {{ s.heading }}
        </{{ heading_tag }}>
      {%- endif -%}

      <div class="comparison__scroller" ref="scroller">
        <table class="comparison__table">
          <tbody>
            <tr>
              <td class="comparison__attribute comparison__attribute--empty"></td>

              <th scope="col" class="comparison__column comparison__column--current">
                {%- render 'resource-card',
                  resource: product,
                  resource_type: 'product',
                  image_aspect_ratio: '1 / 1',
                  image_sizes: card_sizes
                -%}
              </th>

              {%- if use_metafields -%}
                {%- for cp in compare_products -%}
                  {%- unless cp.id == product.id -%}
                    <th scope="col" class="comparison__column">
                      {%- render 'resource-card',
                        resource: cp,
                        resource_type: 'product',
                        image_aspect_ratio: '1 / 1',
                        image_sizes: card_sizes
                      -%}
                    </th>
                  {%- endunless -%}
                {%- endfor -%}
              {%- else -%}
                {%- comment -%}
                  Manual-mode columns. An uploaded image is preferred; the URL settings are
                  there for stills that live outside the shop's media library.
                  theme-check-disable RemoteAsset
                {%- endcomment -%}
                {%- for i in (1..2) -%}
                  {%- liquid
                    if i == 1
                      assign col_image = s.manual_image_1
                      assign col_url = s.manual_image_1_url
                      assign col_label = s.manual_label_1
                    else
                      assign col_image = s.manual_image_2
                      assign col_url = s.manual_image_2_url
                      assign col_label = s.manual_label_2
                    endif
                    assign col_alt = col_label | strip_html | strip
                  -%}
                  <th scope="col" class="comparison__column">
                    {%- if col_image != blank -%}
                      {{
                        col_image
                        | image_url: width: 460
                        | image_tag:
                          widths: '230, 345, 460',
                          sizes: card_sizes,
                          class: 'comparison__column-image',
                          loading: 'lazy',
                          alt: col_alt
                      }}
                    {%- elsif col_url != blank -%}
                      <img
                        class="comparison__column-image"
                        src="{{ col_url }}"
                        width="230"
                        height="230"
                        loading="lazy"
                        decoding="async"
                        sizes="{{ card_sizes }}"
                        alt="{{ col_alt | escape }}"
                      >
                    {%- endif -%}
                    {%- if col_label != blank -%}
                      <span class="comparison__column-label">{{ col_label }}</span>
                    {%- endif -%}
                  </th>
                {%- endfor -%}
                {%- comment -%} theme-check-enable RemoteAsset {%- endcomment -%}
              {%- endif -%}
            </tr>

            {%- if use_metafields -%}
              {%- for entry in features -%}
                {%- liquid
                  assign feature_name = entry.feature_name.value | default: entry.feature_name | strip_html | strip
                -%}
                {%- if feature_name == blank -%}
                  {%- continue -%}
                {%- endif -%}
                <tr>
                  <th scope="row" class="comparison__attribute">{{ feature_name }}</th>

                  {%- assign current_value = entry[current_key] | metafield_tag | strip_html | strip -%}
                  <td class="comparison__cell comparison__cell--current">
                    {{ current_value | default: '—' }}
                  </td>

                  {%- for cp in compare_products -%}
                    {%- unless cp.id == product.id -%}
                      {%- liquid
                        assign cp_key = cp.metafields[ns][compare_key_key].value | handle | replace: '-', '_'
                        if cp_key == blank
                          assign cp_key = cp.handle | replace: '-', '_'
                        endif
                        assign cp_value = entry[cp_key] | metafield_tag | strip_html | strip
                      -%}
                      <td class="comparison__cell">{{ cp_value | default: '—' }}</td>
                    {%- endunless -%}
                  {%- endfor -%}
                </tr>
              {%- endfor -%}
            {%- else -%}
              {%- comment -%}
                Manual rows, one per line, cells split on the pipe:
                "attribute | this product | alternative 1 | alternative 2".
              {%- endcomment -%}
              {%- for row in manual_rows -%}
                {%- liquid
                  assign clean_row = row | strip_html | strip
                -%}
                {%- if clean_row == blank -%}
                  {%- continue -%}
                {%- endif -%}
                {%- assign cells = clean_row | split: '|' -%}
                {%- assign row_label = cells[0] | strip -%}
                {%- if row_label == blank -%}
                  {%- continue -%}
                {%- endif -%}
                <tr>
                  <th scope="row" class="comparison__attribute">{{ row_label }}</th>
                  <td class="comparison__cell comparison__cell--current">{{ cells[1] | strip | default: '—' }}</td>
                  <td class="comparison__cell">{{ cells[2] | strip | default: '—' }}</td>
                  <td class="comparison__cell">{{ cells[3] | strip | default: '—' }}</td>
                </tr>
              {%- endfor -%}
            {%- endif -%}
          </tbody>
        </table>
      </div>

      {%- if s.footnote != blank -%}
        <p class="comparison__footnote">{{ s.footnote }}</p>
      {%- endif -%}
    </comparison-table>
  {%- endcapture -%}

  {% render 'section',
    section: section,
    children: children,
    section_id: section.id,
    background_color: s.background_color
  %}

  {% style %}
    #shopify-section-{{ section.id }} {
      content-visibility: auto;
      contain-intrinsic-size: auto 640px;
    }
  {% endstyle %}

  <script type="module">
    if (!customElements.get('comparison-table')) {
      customElements.define(
        'comparison-table',
        class ComparisonTable extends HTMLElement {
          connectedCallback() {
            this.scroller = this.querySelector('[ref="scroller"]');
            if (!this.scroller) return;

            // Pointer events give us mouse + pen in one path; touch keeps native scrolling.
            this.scroller.addEventListener('pointerdown', this.onDown);
            this.scroller.addEventListener('dragstart', (event) => event.preventDefault());
          }

          onDown = (event) => {
            if (event.pointerType === 'touch' || event.button !== 0) return;

            const startX = event.clientX;
            const startLeft = this.scroller.scrollLeft;
            let dragging = false;

            const onMove = (moveEvent) => {
              const delta = moveEvent.clientX - startX;
              if (!dragging && Math.abs(delta) > 6) {
                dragging = true;
                this.scroller.classList.add('is-dragging');
              }
              if (dragging) this.scroller.scrollLeft = startLeft - delta;
            };

            const onUp = () => {
              window.removeEventListener('pointermove', onMove);
              window.removeEventListener('pointerup', onUp);
              window.removeEventListener('pointercancel', onUp);
              this.scroller.classList.remove('is-dragging');
              // Swallow the click that ends a drag so cards don't navigate.
              if (dragging) {
                this.scroller.addEventListener('click', (clickEvent) => {
                  clickEvent.preventDefault();
                  clickEvent.stopPropagation();
                }, { capture: true, once: true });
              }
            };

            window.addEventListener('pointermove', onMove);
            window.addEventListener('pointerup', onUp);
            window.addEventListener('pointercancel', onUp);
          };

          disconnectedCallback() {
            if (this.scroller) this.scroller.removeEventListener('pointerdown', this.onDown);
          }
        }
      );
    }
  </script>

{%- elsif request.design_mode -%}

  {%- comment -%}
    Editor-only placeholder so the section stays selectable while it has no content.
    Never renders on the storefront. Delete this branch to hide it in the editor too.
  {%- endcomment -%}
  {%- capture children -%}
    <div class="comparison comparison-placeholder">
      {%- if product == blank -%}
        Aplus comparison reads product metafields, so it only has content on a product
        template. This section is hidden on the storefront.
      {%- elsif handle_forced and s.enable_manual == false -%}
        <b>{{ product.handle }}</b> is listed under "Manual product handles", but
        "Use manual rows" is off, so there is nothing to render. Tick it, or remove the
        handle from the list to use metafield data instead.
      {%- elsif handle_forced and manual_rows == blank -%}
        <b>{{ product.handle }}</b> is set to manual mode, but no rows have been typed in.
        Add rows under "Manual rows", or remove the handle from the list.
      {%- elsif other_columns == 0 and compare_products != blank -%}
        <b>{{ ns }}.{{ products_key }}</b> has no product other than this one, so there is
        nothing to compare against. Add at least one more product reference.
      {%- elsif compare_products == blank -%}
        Aplus comparison: no products found in <b>{{ ns }}.{{ products_key }}</b> for this
        product. This section is hidden on the storefront.
      {%- elsif valid_features == 0 -%}
        <b>{{ ns }}.{{ features_key }}</b> has no rows with a feature name, so the table
        would have headers and nothing else. This section is hidden on the storefront.
      {%- else -%}
        Aplus comparison has no content to render. Check
        <b>{{ ns }}.{{ features_key }}</b> and <b>{{ ns }}.{{ products_key }}</b>.
      {%- endif -%}
    </div>
  {%- endcapture -%}

  {% render 'section',
    section: section,
    children: children,
    section_id: section.id,
    background_color: s.background_color
  %}

{%- endif -%}

{% stylesheet %}
  .comparison {
    display: block;
    width: 100%;
    align-self: stretch;
    max-width: 920px;
    margin: 0 auto;
  }

  .comparison-placeholder {
    padding: 32px;
    text-align: center;
    border: 1px dashed currentcolor;
    border-radius: 8px;
    opacity: 0.65;
  }

  .comparison__scroller {
    overflow-x: auto;
    border-radius: var(--comparison-radius, 8px);
    cursor: grab;
  }

  .comparison__scroller.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  .comparison__table {
    border-collapse: separate;
    border-spacing: 0;
    width: 100%;
  }

  .comparison__table :is(td, th) {
    border-block-end: 1px solid var(--comparison-border);
    border-inline-end: 1px solid var(--comparison-border);
    padding: var(--padding-xs) var(--padding-sm);
    background-color: var(--color-background);
    vertical-align: middle;
    text-align: center;
    font-size: var(--font-paragraph--size, 0.875rem);
  }

  /* Sticky first column so attribute names stay readable while the table scrolls. */
  .comparison__attribute {
    position: sticky;
    inset-inline-start: 0;
    z-index: var(--layer-raised, 2);
    min-width: var(--comparison-column-width);
    text-align: start;
    font-weight: 600;
    background-color: var(--comparison-attribute-background);
    border-inline-start: 1px solid var(--comparison-border);
  }

  .comparison__attribute--empty {
    border: 0;
    background: transparent;
  }

  .comparison__column,
  .comparison__cell {
    inline-size: var(--comparison-column-width);
    min-inline-size: var(--comparison-column-width);
    max-inline-size: var(--comparison-column-width);
  }

  .comparison__column {
    border-block-end: 0;
    vertical-align: bottom;
  }

  .comparison__column-image {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    display: block;
  }

  .comparison__column-label {
    display: block;
    margin-block-start: var(--margin-xs, 0.5rem);
    font-weight: 600;
  }

  /* The resource-card is height:100% by default, which would stretch the header row. */
  .comparison__column .resource-card,
  .comparison__column .resource-card__wrapper {
    height: auto;
  }

  .comparison__table tr:last-child td:last-child {
    border-bottom-right-radius: var(--comparison-radius, 8px);
    }
    .comparison__table tr:last-child th:first-child {
    border-bottom-left-radius: var(--comparison-radius, 8px);
    }

    .comparison__table tr:first-child th {
    border-block-start: 1px solid var(--comparison-border);
    }
    .comparison__table tr:first-child th:last-child {
    border-top-right-radius: var(--comparison-radius, 8px);
    }
    .comparison__table tr:first-child th:first-of-type {
    border-top-left-radius: var(--comparison-radius, 8px);
    border-inline-start: 1px solid var(--comparison-border);
    }

    .comparison__table tr:first-child td.comparison__attribute.comparison__attribute--empty {
        border-inline-end: 0
    }


  .comparison__footnote {
    margin-block-start: var(--margin-sm, 0.75rem);
    text-align: center;
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .comparison__scroller {
      cursor: auto;
    }

    .comparison__attribute {
      min-width: 9.5rem;
    }

    .comparison__column,
    .comparison__cell {
      inline-size: 10rem;
      min-inline-size: 10rem;
      max-inline-size: 10rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Aplus comparison",
  "class": "section-wrapper",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to hide the heading."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "HTML tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "p", "label": "Paragraph" },
        { "value": "div", "label": "Div" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_type_preset",
      "label": "Type preset",
      "info": "Uses the theme's typography presets.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "paragraph", "label": "Paragraph" },
        { "value": "rte", "label": "Rich text" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Font",
      "options": [
        { "value": "var(--font-heading--family)", "label": "Heading" },
        { "value": "var(--font-body--family)", "label": "Body" },
        { "value": "var(--font-subheading--family)", "label": "Subheading" },
        { "value": "var(--font-accent--family)", "label": "Accent" }
      ],
      "default": "var(--font-heading--family)"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Font size (desktop)",
      "info": "0 = use type preset.",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Font size (mobile)",
      "info": "0 = use type preset.",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Line height",
      "info": "0 = use type preset.",
      "min": 0,
      "max": 2.5,
      "step": 0.1,
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Letter spacing",
      "min": -2,
      "max": 10,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "heading_case",
      "label": "Text case",
      "options": [
