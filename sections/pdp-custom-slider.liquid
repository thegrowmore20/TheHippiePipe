{% comment %}
================================================================================
  IMAGE SLIDER — Horizon-structured section (guarded)

  RENDER GUARDS
   1. Slide count is resolved BEFORE anything is output.
        - manual   -> blocks of type 'slide' that actually have an image
        - metafield-> non-blank entries in product.metafields[ns][key].value
   2. Zero slides = the ENTIRE section is skipped: no Horizon wrapper, no
      {% style %}, no markup, no <script>. Nothing hits the DOM.
      Exception: in the theme editor (request.design_mode) a small placeholder
      renders so the merchant can still select and configure the section.
      That branch never runs on the storefront — delete it if unwanted.
   3. Per-element guards:
        - heading    -> only if non-blank after strip
        - <a>        -> only if link is set; aria-label only if there is alt text
        - caption <p>-> only if caption is set
        - controls   -> only if slide_count > the SMALLEST slides-per-view of the
                        three breakpoints (below that, controls can never show at
                        any width, so shipping them is dead DOM + an arrow flash
                        before JS boots)
        - arrows/dots-> only if enabled AND controls are needed
        - lightbox   -> only for the metafield source, which is the only source
                        that produces [data-popup-slide]. Manual sliders no
                        longer ship ~1.5KB of unusable dialog markup.
        - CSS blocks -> heading / caption / controls / lightbox rules are only
                        emitted when that part actually renders
   4. Eager + fetchpriority now track the FIRST RENDERED slide, not forloop.first.
      Previously a blank first block meant no image got LCP priority at all.

  UNCHANGED
   - Slider/lightbox JS, class names, visuals, drag, autoplay, dots.
   - Metafield logic, srcset/sizes, perf work (debounced resize, rAF writes,
     IntersectionObserver + visibilitychange autoplay pausing, inline close SVG).
================================================================================
{% endcomment %}

{%- liquid
  assign uid = section.id | replace: '_', '' | replace: '-', '' | downcase
  assign heading_tag = section.settings.heading_tag | default: 'h2'

  assign heading_text = section.settings.heading | strip
  assign has_heading = false
  if heading_text != blank
    assign has_heading = true
  endif

  assign is_metafield = false
  if section.settings.data_source == 'metafield'
    assign is_metafield = true
  endif

  comment
    Resolve the source once, then count only slides that will actually render.
  endcomment
  assign slide_count = 0

  if is_metafield
    if section.settings.metafield_namespace != blank and section.settings.metafield_key != blank
      assign metafield_data = product.metafields[section.settings.metafield_namespace][section.settings.metafield_key]
      if metafield_data
        assign metafield_images = metafield_data.value
        for image in metafield_images
          if image != blank
            assign slide_count = slide_count | plus: 1
          endif
        endfor
      endif
    endif
  else
    for block in section.blocks
      if block.type == 'slide' and block.settings.image != blank
        assign slide_count = slide_count | plus: 1
      endif
    endfor
  endif

  assign has_slides = false
  if slide_count > 0
    assign has_slides = true
  endif

  comment
    Controls can only ever be needed if slide_count exceeds the smallest
    slides-per-view across all three breakpoints.
  endcomment
  assign min_slides_per_view = section.settings.slides_desktop
  if section.settings.slides_tablet < min_slides_per_view
    assign min_slides_per_view = section.settings.slides_tablet
  endif
  if section.settings.slides_mobile < min_slides_per_view
    assign min_slides_per_view = section.settings.slides_mobile
  endif

  assign controls_possible = false
  if slide_count > min_slides_per_view
    assign controls_possible = true
  endif

  assign render_arrows = false
  if controls_possible and section.settings.show_arrows
    assign render_arrows = true
  endif

  assign render_dots = false
  if controls_possible and section.settings.show_dots
    assign render_dots = true
  endif

  assign render_controls = false
  if render_arrows or render_dots
    assign render_controls = true
  endif

  assign render_lightbox = false
  if is_metafield and has_slides
    assign render_lightbox = true
  endif

  assign render_captions = false
  if is_metafield == false
    assign render_captions = true
  endif
-%}

{%- if has_slides -%}

  {% style %}
    #shopify-section-{{ section.id }} {
      content-visibility: auto;
      contain-intrinsic-size: auto 720px;
    }

    {% if has_heading %}
      /* -------------------------------------------------------------- heading */
      .ai-slider-heading-{{ uid }} {
        display: block;
        margin: 0;
        width: {{ section.settings.heading_width }};
        margin-block-start: {{ section.settings.heading_margin_top }}px;
        margin-block-end: {{ section.settings.heading_margin_bottom }}px;
        padding-block-start: {{ section.settings.heading_padding_block_start }}px;
        padding-block-end: {{ section.settings.heading_padding_block_end }}px;
        padding-inline-start: {{ section.settings.heading_padding_inline_start }}px;
        padding-inline-end: {{ section.settings.heading_padding_inline_end }}px;
        text-align: {{ section.settings.heading_alignment }};
        text-wrap: pretty;
        font-family: {{ section.settings.heading_font }};
        {% if section.settings.heading_case != 'none' %}
          text-transform: {{ section.settings.heading_case }};
        {% endif %}
        {% if section.settings.heading_font_size > 0 %}
          font-size: {{ section.settings.heading_font_size }}px;
        {% endif %}
        {% if section.settings.heading_line_height > 0 %}
          line-height: {{ section.settings.heading_line_height }};
        {% endif %}
        {% if section.settings.heading_letter_spacing != 0 %}
          letter-spacing: {{ section.settings.heading_letter_spacing }}px;
        {% endif %}
        {% if section.settings.heading_color != blank %}
          color: {{ section.settings.heading_color }};
        {% endif %}
      }

      {% if section.settings.heading_max_width == 'narrow' %}
        .ai-slider-heading-{{ uid }} { max-width: 45ch; }
      {% elsif section.settings.heading_max_width == 'normal' %}
        .ai-slider-heading-{{ uid }} { max-width: 75ch; }
      {% endif %}

      {% if section.settings.heading_alignment == 'center' %}
        .ai-slider-heading-{{ uid }} { margin-inline: auto; }
      {% elsif section.settings.heading_alignment == 'right' %}
        .ai-slider-heading-{{ uid }} { margin-inline-start: auto; }
      {% endif %}
    {% endif %}

    /* --------------------------------------------------------------- slider */
    .ai-slider-container-{{ uid }} {
      width: 100%;
      align-self: stretch;
      display: block;
      position: relative;
    }

    .ai-slider-wrapper-{{ uid }} {
      width: 100%;
      overflow: hidden;
      position: relative;
    }

    .ai-slider-track-{{ uid }} {
      display: flex;
      gap: {{ section.settings.slide_gap }}px;
      align-items: stretch;
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: grab;
      user-select: none;
    }

    .ai-slider-track-{{ uid }}.dragging {
      cursor: grabbing;
      transition: none;
    }

    .ai-slider-slide-{{ uid }} {
      flex-shrink: 0;
      position: relative;
      display: flex;
      flex-direction: column;
      height: auto;
    }

    .ai-slider-slide-{{ uid }}[data-popup-slide] {
      cursor: pointer;
    }

    .ai-slider-image-wrapper-{{ uid }} {
      position: relative;
      width: 100%;
      overflow: hidden;
      border-radius: {{ section.settings.slide_border_radius }}px;
      {% if section.settings.aspect_ratio == 'auto' %}
        flex-grow: 1;
      {% endif %}
    }

    .ai-slider-image-wrapper-{{ uid }} a {
      display: block;
      width: 100%;
      height: 100%;
    }

    .ai-slider-image-wrapper-{{ uid }} img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      pointer-events: none;
      border-radius: {{ section.settings.slide_border_radius }}px;
    }

    {% if section.settings.aspect_ratio == 'square' %}
      .ai-slider-image-wrapper-{{ uid }} { aspect-ratio: 1 / 1; }
    {% elsif section.settings.aspect_ratio == 'landscape' %}
      .ai-slider-image-wrapper-{{ uid }} { aspect-ratio: 4 / 3; }
    {% elsif section.settings.aspect_ratio == 'portrait' %}
      .ai-slider-image-wrapper-{{ uid }} { aspect-ratio: 3 / 4; }
    {% elsif section.settings.aspect_ratio == '16-9' %}
      .ai-slider-image-wrapper-{{ uid }} { aspect-ratio: 16 / 9; }
    {% elsif section.settings.aspect_ratio == '9-16' %}
      .ai-slider-image-wrapper-{{ uid }} { aspect-ratio: 9 / 16; }
    {% endif %}

    {% if render_captions %}
      .ai-slider-caption-{{ uid }} {
        margin-top: 12px;
        margin-bottom: 0;
        font-size: 1.1rem;
        color: {{ section.settings.caption_color | default: '#000000' }};
      }
    {% endif %}

    {% if render_controls %}
      .ai-slider-controls-{{ uid }} {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        margin-top: 24px;
        max-width: 100%;
      }

      .ai-slider-controls-{{ uid }}.hidden {
        display: none;
      }
    {% endif %}

    {% if render_arrows %}
      .ai-slider-arrow-{{ uid }} {
        background: {{ section.settings.arrow_background }};
        border: 1px solid {{ section.settings.arrow_background }};
        cursor: pointer;
        padding: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        flex-shrink: 0;
        border-radius: 50%;
      }

      .ai-slider-arrow-{{ uid }}:hover {
        background-color: {{ section.settings.arrow_background }};
        color: {{ section.settings.arrow_color }};
        transform: scale(1.1);
      }

      .ai-slider-arrow-{{ uid }}:disabled {
        opacity: 0.3;
        cursor: not-allowed;
      }

      .ai-slider-arrow-{{ uid }}:disabled:hover {
        transform: none;
      }

      .ai-slider-arrow-{{ uid }} svg {
        width: 24px;
        height: 24px;
        stroke: {{ section.settings.arrow_color }};
        stroke-width: 2;
        fill: none;
      }
    {% endif %}

    {% if render_dots %}
      .ai-slider-dots-{{ uid }} {
        display: flex;
        gap: 8px;
        align-items: center;
        overflow-x: auto;
        scroll-behavior: smooth;
        max-width: min(60vw, 570px);
        padding: 4px 0;
        position: relative;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }

      .ai-slider-dots-{{ uid }}::-webkit-scrollbar {
        display: none;
      }

      .ai-slider-dot-{{ uid }} {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: {{ section.settings.dot_color }};
        opacity: 0.3;
        border: none;
        padding: 0;
        cursor: pointer;
        transition: opacity 0.3s ease;
        flex-shrink: 0;
      }

      .ai-slider-dot-{{ uid }}.active {
        opacity: 1;
      }
    {% endif %}

    {% if render_lightbox %}
      /* ------------------------------------------------------------ lightbox */
      .ai-slider-lightbox-{{ uid }} {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: rgba(0, 0, 0, 0.9);
      }

      .ai-slider-lightbox-{{ uid }}.active {
        display: flex;
      }

      .ai-slider-lightbox-dialog-{{ uid }} {
        position: relative;
        width: min(1100px, 100%);
        display: grid;
        grid-template-columns: 56px minmax(0, 1fr) 56px;
        gap: 16px;
        align-items: center;
      }

      .ai-slider-lightbox-stage-{{ uid }} {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        touch-action: pan-y;
        cursor: grab;
      }

      .ai-slider-lightbox-stage-{{ uid }}.dragging {
        cursor: grabbing;
      }

      .ai-slider-lightbox-image-{{ uid }} {
        width: 100%;
        max-height: 78vh;
        object-fit: contain;
        display: block;
        user-select: none;
        -webkit-user-drag: none;
      }

      .ai-slider-lightbox-caption-wrap-{{ uid }} {
        padding: 16px 20px 18px;
      }

      .ai-slider-lightbox-caption-{{ uid }} {
        margin: 0;
        color: #000;
        font-size: 1rem;
        line-height: 1.5;
      }

      .ai-slider-lightbox-dots-{{ uid }} {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 14px;
      }

      .ai-slider-lightbox-dot-{{ uid }} {
        width: 8px;
        height: 8px;
        border: none;
        padding: 0;
        border-radius: 50%;
        background: #fff;
        opacity: 0.25;
        cursor: pointer;
        transition: opacity 0.3s ease;
      }

      .ai-slider-lightbox-dot-{{ uid }}.active {
        opacity: 1;
      }

      .ai-slider-lightbox-arrow-{{ uid }},
      .ai-slider-lightbox-close-{{ uid }} {
        border: none;
        background: #fff;
        color: #000;
        cursor: pointer;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
        transition: transform 0.2s ease, opacity 0.2s ease;
        flex-shrink: 0;
      }

      .ai-slider-lightbox-arrow-{{ uid }}:hover,
      .ai-slider-lightbox-close-{{ uid }}:hover {
        transform: scale(1.06);
      }

      .ai-slider-lightbox-arrow-{{ uid }}:disabled {
        opacity: 0.35;
        cursor: not-allowed;
        transform: none;
      }

      .ai-slider-lightbox-arrow-{{ uid }} svg {
        width: 22px;
        height: 22px;
        stroke: #000;
        stroke-width: 2;
        fill: none;
      }

      .ai-slider-lightbox-close-{{ uid }} {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 3;
        line-height: 1;
      }
    {% endif %}

    {% if render_dots %}
      @media screen and (max-width: 767px) {
        .ai-slider-dots-{{ uid }} {
          max-width: min(60vw, 240px);
        }
      }
    {% endif %}

    @media screen and (max-width: 749px) {
      {% if has_heading %}
        .ai-slider-heading-{{ uid }} {
          text-align: {{ section.settings.heading_alignment_mobile }};
          {% if section.settings.heading_font_size_mobile > 0 %}
            font-size: {{ section.settings.heading_font_size_mobile }}px;
          {% endif %}
          {% if section.settings.heading_alignment_mobile == 'center' %}
            margin-inline: auto;
          {% elsif section.settings.heading_alignment_mobile == 'right' %}
            margin-inline-start: auto;
            margin-inline-end: 0;
          {% else %}
            margin-inline-start: 0;
            margin-inline-end: auto;
          {% endif %}
        }
      {% endif %}

      {% if render_controls %}
        .ai-slider-controls-{{ uid }} {
          gap: 12px;
          margin-top: 16px;
        }
      {% endif %}

      {% if render_arrows %}
        .ai-slider-arrow-{{ uid }} svg {
          width: 20px;
          height: 20px;
        }
      {% endif %}

      {% if render_lightbox %}
        .ai-slider-lightbox-{{ uid }} {
          padding: 16px;
        }

        .ai-slider-lightbox-dialog-{{ uid }} {
          grid-template-columns: 1fr;
        }

        .ai-slider-lightbox-arrow-{{ uid }} {
          position: absolute;
          top: 45%;
          transform: translateY(-45%);
          z-index: 3;
          width: 30px;
          height: 30px;
        }

        .ai-slider-lightbox-close-{{ uid }} {
          width: 30px;
          height: 30px;
        }

        .ai-slider-lightbox-arrow-{{ uid }}:hover {
          transform: translateY(-50%) scale(1.04);
        }

        .ai-slider-lightbox-prev-{{ uid }} {
          left: -8px;
        }

        .ai-slider-lightbox-next-{{ uid }} {
          right: -8px;
        }

        .ai-slider-lightbox-image-{{ uid }} {
          max-height: 70vh;
        }

        .ai-slider-lightbox-caption-wrap-{{ uid }} {
          padding: 14px 16px 16px;
        }
      {% endif %}
    }
  {% endstyle %}

  {%- capture children -%}
    {%- if has_heading -%}
      <{{ heading_tag }} class="ai-slider-heading-{{ uid }} {{ section.settings.heading_type_preset }}">
        {{ section.settings.heading }}
      </{{ heading_tag }}>
    {%- endif -%}

    <image-slider-{{ uid }} class="ai-slider-container-{{ uid }}">
      <div class="ai-slider-wrapper-{{ uid }}">
        <div class="ai-slider-track-{{ uid }}" data-slider-track>
          {%- if is_metafield -%}

            {%- assign rendered = 0 -%}
            {%- for image in metafield_images -%}
              {%- if image == blank -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign rendered = rendered | plus: 1 -%}
              {%- liquid
                assign lazyload = 'lazy'
                if rendered == 1
                  assign lazyload = 'eager'
                endif
              -%}
              <div class="ai-slider-slide-{{ uid }} ai-slider-slide-custom" data-popup-slide>
                <div class="ai-slider-image-wrapper-{{ uid }}">
                  <img
                    src="{{ image | image_url: width: 400 }}"
                    srcset="{{ image | image_url: width: 300 }} 300w,
                            {{ image | image_url: width: 400 }} 400w,
                            {{ image | image_url: width: 600 }} 600w,
                            {{ image | image_url: width: 800 }} 800w"
                    sizes="(max-width: 749px) calc(100vw / {{ section.settings.slides_mobile }}),
                           (max-width: 989px) calc(100vw / {{ section.settings.slides_tablet }}),
                           calc(100vw / {{ section.settings.slides_desktop }})"
                    alt="{{ image.alt | escape }}"
                    loading="{{ lazyload }}"
                    {% if rendered == 1 %}fetchpriority="high"{% endif %}
                    width="400"
                    height="800"
                    data-lightbox-src="{{ image | image_url: width: 1200 }}"
                  >
                </div>
              </div>
            {%- endfor -%}

          {%- else -%}

            {%- assign rendered = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type != 'slide' or block.settings.image == blank -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign rendered = rendered | plus: 1 -%}
              {%- liquid
                assign lazyload = 'lazy'
                if rendered == 1
                  assign lazyload = 'eager'
                endif
                assign img_alt = block.settings.image.alt | default: block.settings.caption
              -%}
              <div class="ai-slider-slide-{{ uid }}" {{ block.shopify_attributes }}>
                <div class="ai-slider-image-wrapper-{{ uid }}">
                  {%- if block.settings.link != blank -%}
                    <a
                      href="{{ block.settings.link }}"
                      {% if img_alt != blank %}aria-label="{{ img_alt | escape }}"{% endif %}
                      {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
                    >
                      <img
                        src="{{ block.settings.image | image_url: width: 400 }}"
                        srcset="{{ block.settings.image | image_url: width: 300 }} 300w,
                                {{ block.settings.image | image_url: width: 400 }} 400w,
                                {{ block.settings.image | image_url: width: 600 }} 600w,
                                {{ block.settings.image | image_url: width: 800 }} 800w"
                        sizes="(max-width: 749px) calc(100vw / {{ section.settings.slides_mobile }}),
                               (max-width: 989px) calc(100vw / {{ section.settings.slides_tablet }}),
                               calc(100vw / {{ section.settings.slides_desktop }})"
                        alt="{{ img_alt | escape }}"
                        loading="{{ lazyload }}"
                        {% if rendered == 1 %}fetchpriority="high"{% endif %}
                        width="400"
                        height="800"
                      >
                    </a>
                  {%- else -%}
                    <img
                      src="{{ block.settings.image | image_url: width: 400 }}"
                      srcset="{{ block.settings.image | image_url: width: 300 }} 300w,
                              {{ block.settings.image | image_url: width: 400 }} 400w,
                              {{ block.settings.image | image_url: width: 600 }} 600w,
                              {{ block.settings.image | image_url: width: 800 }} 800w"
                      sizes="(max-width: 749px) calc(100vw / {{ section.settings.slides_mobile }}),
                             (max-width: 989px) calc(100vw / {{ section.settings.slides_tablet }}),
                             calc(100vw / {{ section.settings.slides_desktop }})"
                      alt="{{ img_alt | escape }}"
                      loading="{{ lazyload }}"
                      {% if rendered == 1 %}fetchpriority="high"{% endif %}
                      width="400"
                      height="800"
                    >
                  {%- endif -%}
                </div>
                {%- if block.settings.caption != blank -%}
                  <p class="ai-slider-caption-{{ uid }}">{{ block.settings.caption }}</p>
                {%- endif -%}
              </div>
            {%- endfor -%}

          {%- endif -%}
        </div>
      </div>

      {%- if render_controls -%}
        <div class="ai-slider-controls-{{ uid }}" data-slider-controls>
          {%- if render_arrows -%}
            <button class="ai-slider-arrow-{{ uid }} ai-slider-prev-{{ uid }}" type="button" data-slider-prev aria-label="Previous slide">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
          {%- endif -%}

          {%- if render_dots -%}
            <div class="ai-slider-dots-{{ uid }}" data-slider-dots></div>
          {%- endif -%}

          {%- if render_arrows -%}
            <button class="ai-slider-arrow-{{ uid }} ai-slider-next-{{ uid }}" type="button" data-slider-next aria-label="Next slide">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <polyline points="9 6 15 12 9 18"></polyline>
              </svg>
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if render_lightbox -%}
        <div class="ai-slider-lightbox-{{ uid }}" data-lightbox aria-hidden="true">
          <button class="ai-slider-lightbox-close-{{ uid }}" type="button" data-lightbox-close aria-label="Close popup">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
          <div class="ai-slider-lightbox-dialog-{{ uid }}" role="dialog" aria-modal="true" aria-label="Image popup slider">
            <button class="ai-slider-lightbox-arrow-{{ uid }} ai-slider-lightbox-prev-{{ uid }}" type="button" data-lightbox-prev aria-label="Previous image">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>

            <div class="ai-slider-lightbox-stage-{{ uid }}">
              <img
                class="ai-slider-lightbox-image-{{ uid }}"
                data-lightbox-image
                src=""
                alt=""
                width="1200"
                height="1200"
              >
              <div class="ai-slider-lightbox-caption-wrap-{{ uid }}">
                <p class="ai-slider-lightbox-caption-{{ uid }}" data-lightbox-caption></p>
                <div class="ai-slider-lightbox-dots-{{ uid }}" data-lightbox-dots></div>
              </div>
            </div>

            <button class="ai-slider-lightbox-arrow-{{ uid }} ai-slider-lightbox-next-{{ uid }}" type="button" data-lightbox-next aria-label="Next image">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <polyline points="9 6 15 12 9 18"></polyline>
              </svg>
            </button>
          </div>
        </div>
      {%- endif -%}
    </image-slider-{{ uid }}>
  {%- endcapture -%}

  {% render 'section',
    section: section,
    children: children,
    section_id: section.id,
    background_color: section.settings.background_color
  %}

  <script type="module">
    (function() {
      class ImageSlider{{ uid }} extends HTMLElement {
        constructor() {
          super();
          this.currentIndex = 0;
          this.isDragging = false;
          this.startPos = 0;
          this.currentTranslate = 0;
          this.prevTranslate = 0;
          this.autoplayInterval = null;
          this.dragJustHappened = false;

          this.lightboxIndex = 0;
          this.popupItems = [];

          this.lightboxIsDragging = false;
          this.lightboxStartPos = 0;
          this.lightboxCurrentTranslate = 0;
          this.lightboxDragJustHappened = false;

          this.slideWidth = 0;
          this._lastDotCount = null;
          this._wcTimer = null;
          this._io = null;
          this._onVisibility = null;

          this.handleResize = this.handleResize.bind(this);
          this.handleKeydown = this.handleKeydown.bind(this);
        }

        connectedCallback() {
          this.track = this.querySelector('[data-slider-track]');
          this.slides = Array.from(this.querySelectorAll('.ai-slider-slide-{{ uid }}'));
          this.popupSlides = Array.from(this.querySelectorAll('.ai-slider-slide-{{ uid }}[data-popup-slide]'));
          this.controls = this.querySelector('[data-slider-controls]');
          this.prevBtn = this.querySelector('[data-slider-prev]');
          this.nextBtn = this.querySelector('[data-slider-next]');
          this.dotsContainer = this.querySelector('[data-slider-dots]');

          this.lightbox = this.querySelector('[data-lightbox]');
          this.lightboxStage = this.querySelector('.ai-slider-lightbox-stage-{{ uid }}');
          this.lightboxImage = this.querySelector('[data-lightbox-image]');
          this.lightboxCaption = this.querySelector('[data-lightbox-caption]');
          this.lightboxDots = this.querySelector('[data-lightbox-dots]');
          this.lightboxPrevBtn = this.querySelector('[data-lightbox-prev]');
          this.lightboxNextBtn = this.querySelector('[data-lightbox-next]');

          this.settings = {
            slidesDesktop: {{ section.settings.slides_desktop }},
            slidesTablet: {{ section.settings.slides_tablet }},
            slidesMobile: {{ section.settings.slides_mobile }},
            gap: {{ section.settings.slide_gap }},
            autoplay: {{ section.settings.autoplay }},
            autoplaySpeed: {{ section.settings.autoplay_speed }},
            infinite: {{ section.settings.infinite_loop }},
            showArrows: {{ render_arrows }},
            showDots: {{ render_dots }},
            enablePopup: {{ render_lightbox }}
          };

          if (!this.track || this.slides.length === 0) return;

          this._initialized = false;
          this.initWhenNearViewport();
        }

        initWhenNearViewport() {
          const initialize = () => {
            if (this._initialized || !this.isConnected) return;
            this._initialized = true;
            this._initIO?.disconnect();
            this.init();
          };

          if (typeof IntersectionObserver === 'undefined') {
            if ('requestIdleCallback' in window) {
              requestIdleCallback(initialize, { timeout: 1200 });
            } else {
              setTimeout(initialize, 0);
            }
            return;
          }

          this._initIO = new IntersectionObserver((entries) => {
            if (entries.some((entry) => entry.isIntersecting)) initialize();
          }, { rootMargin: '300px 0px' });
          this._initIO.observe(this);
        }

        init() {
          this.handleResize = this._debounce(this.handleResize.bind(this), 150);

          this.updateSlidesPerView();
          this.updateSlideWidths();
          this.createDots();
          this.updateControls();
          this.preparePopupItems();
          this.createLightboxDots();
          this.attachEvents();
          this.goToSlide(this.currentIndex);

          if (this.settings.autoplay) {
            this.startAutoplay();

            if (typeof IntersectionObserver !== 'undefined') {
              this._io = new IntersectionObserver((entries) => {
                entries.forEach((e) => {
                  if (e.isIntersecting) {
                    this.startAutoplay();
                  } else {
                    clearInterval(this.autoplayInterval);
                  }
                });
              }, { threshold: 0.1 });
              this._io.observe(this);
            }

            this._onVisibility = () => {
              if (document.hidden) {
                clearInterval(this.autoplayInterval);
              } else {
                this.startAutoplay();
              }
            };
            document.addEventListener('visibilitychange', this._onVisibility);
          }

          window.addEventListener('resize', this.handleResize);
        }

        _debounce(fn, delay) {
          let timer;
          return (...args) => {
            clearTimeout(timer);
            timer = setTimeout(() => fn.apply(this, args), delay);
          };
        }

        handleResize() {
          this.updateSlidesPerView();
          this.updateSlideWidths();
          this.createDots();
          this.goToSlide(Math.min(this.currentIndex, this.maxIndex));
        }

        updateSlidesPerView() {
          const width = window.innerWidth;

          if (width < 750) {
            this.slidesPerView = this.settings.slidesMobile;
          } else if (width < 990) {
            this.slidesPerView = this.settings.slidesTablet;
          } else {
            this.slidesPerView = this.settings.slidesDesktop;
          }

          this.maxIndex = Math.max(0, this.slides.length - this.slidesPerView);
        }

        updateSlideWidths() {
          const wrapper = this.track?.parentElement;
          if (!wrapper) return;

          const containerWidth = wrapper.offsetWidth;
          const slideWidth = (containerWidth - (this.settings.gap * (this.slidesPerView - 1))) / this.slidesPerView;
          this.slideWidth = slideWidth;

          requestAnimationFrame(() => {
            this.slides.forEach((slide) => {
              slide.style.width = slideWidth + 'px';
            });
          });
        }

        createDots() {
          if (!this.dotsContainer) return;

          const totalDots = Math.max(1, this.slides.length - this.slidesPerView + 1);

          if (this._lastDotCount === totalDots) {
            return;
          }

          this.dotsContainer.innerHTML = '';

          for (let i = 0; i < totalDots; i++) {
            const dot = document.createElement('button');
            dot.type = 'button';
            dot.className = 'ai-slider-dot-{{ uid }}';
            dot.setAttribute('aria-label', `Go to slide ${i + 1}`);

            if (i === this.currentIndex) {
              dot.classList.add('active');
            }

            dot.addEventListener('click', () => {
              this.goToSlide(i);
              this.resetAutoplay();
            });

            this.dotsContainer.appendChild(dot);
          }

          this._lastDotCount = totalDots;
        }

        updateControls() {
          const shouldShowControls = this.slides.length > this.slidesPerView;

          if (this.controls) {
            this.controls.classList.toggle('hidden', !shouldShowControls);
          }

          if (this.prevBtn && this.nextBtn && !this.settings.infinite) {
            this.prevBtn.disabled = this.currentIndex === 0;
            this.nextBtn.disabled = this.currentIndex >= this.maxIndex;
          }

          if (this.dotsContainer) {
            const dots = this.dotsContainer.querySelectorAll('.ai-slider-dot-{{ uid }}');
            dots.forEach((dot, index) => {
              if (index === this.currentIndex) {
                dot.classList.add('active');

                if (this.dotsContainer.scrollWidth > this.dotsContainer.clientWidth) {
                  const dotLeft = dot.offsetLeft;
                  const dotWidth = dot.offsetWidth;
                  const containerWidth = this.dotsContainer.offsetWidth;

                  this.dotsContainer.scrollTo({
                    left: dotLeft - (containerWidth / 2) + (dotWidth / 2),
                    behavior: 'smooth'
                  });
                }
              } else {
                dot.classList.remove('active');
              }
            });
          }
        }

        preparePopupItems() {
          this.popupItems = this.popupSlides.map((slide) => {
            const img = slide.querySelector('img');
            const caption = slide.querySelector('.ai-slider-caption-{{ uid }}');

            return {
              src: img ? (img.dataset.lightboxSrc || img.getAttribute('src') || '') : '',
              alt: img ? (img.getAttribute('alt') || '') : '',
              caption: caption ? caption.innerHTML : ''
            };
          }).filter(item => item.src);
        }

        createLightboxDots() {
          if (!this.lightboxDots || !this.popupItems.length) return;

          this.lightboxDots.innerHTML = '';

          this.popupItems.forEach((item, index) => {
            const dot = document.createElement('button');
            dot.type = 'button';
            dot.className = 'ai-slider-lightbox-dot-{{ uid }}';
            dot.setAttribute('aria-label', `Go to popup image ${index + 1}`);

            if (index === this.lightboxIndex) {
              dot.classList.add('active');
            }

            dot.addEventListener('click', () => {
              this.lightboxIndex = index;
              this.renderLightbox();
            });

            this.lightboxDots.appendChild(dot);
          });
        }

        attachEvents() {
          if (this.prevBtn) {
            this.prevBtn.addEventListener('click', () => {
              this.prev();
              this.resetAutoplay();
            });
          }

          if (this.nextBtn) {
            this.nextBtn.addEventListener('click', () => {
              this.next();
              this.resetAutoplay();
            });
          }

          this.track.addEventListener('mousedown', this.touchStart.bind(this));
          this.track.addEventListener('touchstart', this.touchStart.bind(this), { passive: true });
          this.track.addEventListener('mouseup', this.touchEnd.bind(this));
          this.track.addEventListener('touchend', this.touchEnd.bind(this));
          this.track.addEventListener('mouseleave', this.touchEnd.bind(this));
          this.track.addEventListener('mousemove', this.touchMove.bind(this));
          this.track.addEventListener('touchmove', this.touchMove.bind(this), { passive: true });
          this.track.addEventListener('dragstart', (e) => e.preventDefault());

          if (this.settings.enablePopup && this.popupSlides.length) {
            this.popupSlides.forEach((slide, index) => {
              slide.addEventListener('click', (event) => {
                this.handleSlideClick(event, index);
              });
            });
          }

          if (this.lightbox) {
            this.lightbox.addEventListener('click', (event) => {
              if (this.lightboxDragJustHappened) {
                event.preventDefault();
                event.stopPropagation();
                return;
              }

              if (event.target === this.lightbox || event.target.closest('[data-lightbox-close]')) {
                this.closeLightbox();
              }
            });
          }

          if (this.lightboxPrevBtn) {
            this.lightboxPrevBtn.addEventListener('click', () => {
              this.lightboxPrev();
            });
          }

          if (this.lightboxNextBtn) {
            this.lightboxNextBtn.addEventListener('click', () => {
              this.lightboxNext();
            });
          }

          if (this.lightboxStage) {
            this.lightboxStage.addEventListener('mousedown', this.lightboxTouchStart.bind(this));
            this.lightboxStage.addEventListener('touchstart', this.lightboxTouchStart.bind(this), { passive: true });

            this.lightboxStage.addEventListener('mousemove', this.lightboxTouchMove.bind(this));
            this.lightboxStage.addEventListener('touchmove', this.lightboxTouchMove.bind(this), { passive: true });

            this.lightboxStage.addEventListener('mouseup', this.lightboxTouchEnd.bind(this));
            this.lightboxStage.addEventListener('mouseleave', this.lightboxTouchEnd.bind(this));
            this.lightboxStage.addEventListener('touchend', this.lightboxTouchEnd.bind(this));
            this.lightboxStage.addEventListener('touchcancel', this.lightboxTouchEnd.bind(this));

            this.lightboxStage.addEventListener('dragstart', (e) => e.preventDefault());
          }
        }

        handleSlideClick(event, index) {
          if (this.dragJustHappened) {
            event.preventDefault();
            event.stopPropagation();
            return;
          }

          if (event.target.closest('a')) {
            event.preventDefault();
          }

          this.openLightbox(index);
        }

        touchStart(event) {
          this.isDragging = true;
          this.dragJustHappened = false;
          this.startPos = this.getPositionX(event);
          this.track.classList.add('dragging');

          clearTimeout(this._wcTimer);
          this.track.style.willChange = 'transform';
        }

        touchMove(event) {
          if (!this.isDragging) return;
          const currentPosition = this.getPositionX(event);
          this.currentTranslate = this.prevTranslate + currentPosition - this.startPos;
        }

        touchEnd() {
          if (!this.isDragging) return;

          this.isDragging = false;
          this.track.classList.remove('dragging');

          const movedBy = this.currentTranslate - this.prevTranslate;
          const absMoved = Math.abs(movedBy);

          if (absMoved > 8) {
            this.dragJustHappened = true;
            setTimeout(() => {
              this.dragJustHappened = false;
            }, 80);
          }

          if (movedBy < -50 && (this.currentIndex < this.maxIndex || this.settings.infinite)) {
            this.next();
          } else if (movedBy > 50 && (this.currentIndex > 0 || this.settings.infinite)) {
            this.prev();
          } else {
            this.goToSlide(this.currentIndex);
          }

          this.resetAutoplay();

          this._wcTimer = setTimeout(() => {
            this.track.style.willChange = 'auto';
          }, 450);
        }

        getPositionX(event) {
          if (event.type.includes('mouse')) {
            return event.pageX;
          }

          const touch = event.touches[0] || event.changedTouches[0];
          return touch ? touch.clientX : 0;
        }

        setSliderPosition() {
          this.track.style.transform = `translateX(${this.currentTranslate}px)`;
        }

        goToSlide(index) {
          this.currentIndex = Math.max(0, Math.min(index, this.maxIndex));
          const slideWidth = this.slideWidth || this.slides[0]?.offsetWidth || 0;
          this.currentTranslate = -this.currentIndex * (slideWidth + this.settings.gap);
          this.prevTranslate = this.currentTranslate;
          this.setSliderPosition();
          this.updateControls();
        }

        next() {
          if (this.settings.infinite && this.currentIndex >= this.maxIndex) {
            this.goToSlide(0);
          } else if (this.currentIndex < this.maxIndex) {
            this.goToSlide(this.currentIndex + 1);
          }
        }

        prev() {
          if (this.settings.infinite && this.currentIndex === 0) {
            this.goToSlide(this.maxIndex);
          } else if (this.currentIndex > 0) {
            this.goToSlide(this.currentIndex - 1);
          }
        }

        openLightbox(index) {
          if (!this.lightbox || !this.popupItems.length) return;

          this.lightboxIndex = Math.max(0, Math.min(index, this.popupItems.length - 1));
          this.renderLightbox();
          this.lightbox.classList.add('active');
          this.lightbox.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
          document.addEventListener('keydown', this.handleKeydown);
          this.resetAutoplay();
        }

        closeLightbox() {
          if (!this.lightbox) return;

          this.lightbox.classList.remove('active');
          this.lightbox.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
          document.removeEventListener('keydown', this.handleKeydown);

          if (this.lightboxStage) {
            this.lightboxStage.classList.remove('dragging');
          }

          this.lightboxCurrentTranslate = 0;
          this.lightboxIsDragging = false;
        }

        renderLightbox() {
          const item = this.popupItems[this.lightboxIndex];
          if (!item || !this.lightboxImage) return;

          this.lightboxImage.src = item.src;
          this.lightboxImage.alt = item.alt || '';

          if (this.lightboxCaption) {
            if (item.caption) {
              this.lightboxCaption.innerHTML = item.caption;
              this.lightboxCaption.style.display = 'block';
            } else {
              this.lightboxCaption.innerHTML = '';
              this.lightboxCaption.style.display = 'none';
            }
          }

          if (this.lightboxDots) {
            const dots = this.lightboxDots.querySelectorAll('.ai-slider-lightbox-dot-{{ uid }}');
            dots.forEach((dot, index) => {
              dot.classList.toggle('active', index === this.lightboxIndex);
            });
          }

          if (this.lightboxPrevBtn && this.lightboxNextBtn && !this.settings.infinite) {
            this.lightboxPrevBtn.disabled = this.lightboxIndex === 0;
            this.lightboxNextBtn.disabled = this.lightboxIndex === this.popupItems.length - 1;
          }

          this.lightboxCurrentTranslate = 0;
        }

        lightboxNext() {
          if (!this.popupItems.length) return;

          if (this.settings.infinite) {
            this.lightboxIndex = (this.lightboxIndex + 1) % this.popupItems.length;
          } else {
            this.lightboxIndex = Math.min(this.lightboxIndex + 1, this.popupItems.length - 1);
          }

          this.renderLightbox();
        }

        lightboxPrev() {
          if (!this.popupItems.length) return;

          if (this.settings.infinite) {
            this.lightboxIndex = (this.lightboxIndex - 1 + this.popupItems.length) % this.popupItems.length;
          } else {
            this.lightboxIndex = Math.max(this.lightboxIndex - 1, 0);
          }

          this.renderLightbox();
        }

        lightboxTouchStart(event) {
          const isOpen = this.lightbox && this.lightbox.classList.contains('active');
          if (!isOpen) return;

          this.lightboxIsDragging = true;
          this.lightboxDragJustHappened = false;
          this.lightboxStartPos = this.getPositionX(event);
          this.lightboxCurrentTranslate = 0;

          if (this.lightboxStage) {
            this.lightboxStage.classList.add('dragging');
          }
        }

        lightboxTouchMove(event) {
          if (!this.lightboxIsDragging) return;

          const currentPosition = this.getPositionX(event);
          this.lightboxCurrentTranslate = currentPosition - this.lightboxStartPos;
        }

        lightboxTouchEnd() {
          if (!this.lightboxIsDragging) return;

          this.lightboxIsDragging = false;

          const movedBy = this.lightboxCurrentTranslate;
          const absMoved = Math.abs(movedBy);

          if (this.lightboxStage) {
            this.lightboxStage.classList.remove('dragging');
          }

          if (absMoved > 8) {
            this.lightboxDragJustHappened = true;
            setTimeout(() => {
              this.lightboxDragJustHappened = false;
            }, 120);
          }

          if (movedBy < -50) {
            this.lightboxNext();
          } else if (movedBy > 50) {
            this.lightboxPrev();
          }

          this.lightboxCurrentTranslate = 0;
        }

        handleKeydown(event) {
          const isOpen = this.lightbox && this.lightbox.classList.contains('active');
          if (!isOpen) return;

          if (event.key === 'Escape') {
            this.closeLightbox();
          }

          if (event.key === 'ArrowRight') {
            event.preventDefault();
            this.lightboxNext();
          }

          if (event.key === 'ArrowLeft') {
            event.preventDefault();
            this.lightboxPrev();
          }
        }

        startAutoplay() {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = setInterval(() => {
            const popupOpen = this.lightbox && this.lightbox.classList.contains('active');
            if (!popupOpen) {
              this.next();
            }
          }, this.settings.autoplaySpeed);
        }

        resetAutoplay() {
          if (this.settings.autoplay) {
            clearInterval(this.autoplayInterval);
            this.startAutoplay();
          }
        }

        disconnectedCallback() {
          if (this.autoplayInterval) {
            clearInterval(this.autoplayInterval);
          }

          clearTimeout(this._wcTimer);

          window.removeEventListener('resize', this.handleResize);
          document.removeEventListener('keydown', this.handleKeydown);

          if (this._onVisibility) {
            document.removeEventListener('visibilitychange', this._onVisibility);
          }

          this._io?.disconnect();
          this._initIO?.disconnect();
        }
      }

      if (!customElements.get('image-slider-{{ uid }}')) {
        customElements.define('image-slider-{{ uid }}', ImageSlider{{ uid }});
      }
    })();
  </script>

{%- elsif request.design_mode -%}

  {%- comment -%}
    Editor-only placeholder. Never renders on the storefront.
    Delete this branch if you want the section invisible in the editor too.
  {%- endcomment -%}
  {%- capture children -%}
    <div style="width:100%;padding:32px;text-align:center;border:1px dashed currentColor;border-radius:8px;opacity:0.65;">
      {%- if is_metafield -%}
        Image slider: no images found in
        {{ section.settings.metafield_namespace | default: 'namespace' }}.{{ section.settings.metafield_key | default: 'key' }}.
        This section is hidden on the storefront.
      {%- else -%}
        Image slider: add at least one slide with an image. This section is hidden on the storefront.
      {%- endif -%}
    </div>
  {%- endcapture -%}

  {% render 'section',
    section: section,
    children: children,
    section_id: section.id,
    background_color: section.settings.background_color
  %}

{%- endif -%}

{% schema %}
{
  "name": "Custom Image slider",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header"]
  },
  "max_blocks": 20,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Slides without an image are skipped."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open in new tab",
          "default": false
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to hide the heading.",
      "default": "Image slider"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "HTML tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "p", "label": "Paragraph" },
        { "value": "div", "label": "Div" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_type_preset",
      "label": "Type preset",
      "info": "Uses the theme's typography presets.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "paragraph", "label": "Paragraph" },
        { "value": "rte", "label": "Rich text" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Font",
      "options": [
        { "value": "var(--font-heading--family)", "label": "Heading" },
        { "value": "var(--font-body--family)", "label": "Body" },
        { "value": "var(--font-subheading--family)", "label": "Subheading" },
        { "value": "var(--font-accent--family)", "label": "Accent" }
      ],
      "default": "var(--font-heading--family)"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Font size (desktop)",
      "info": "0 = use type preset.",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Font size (mobile)",
      "info": "0 = use type preset.",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Line height",
      "info": "0 = use type preset.",
      "min": 0,
      "max": 2.5,
      "step": 0.1,
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Letter spacing",
      "min": -2,
      "max": 10,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "heading_case",
      "label": "Text case",
      "options": [
        { "value": "none", "label": "Default" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "info": "Leave empty to inherit the section color scheme."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alignment (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
