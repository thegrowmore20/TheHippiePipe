{% liquid
  assign skip_contrast = false
  if section.settings.background_media != blank and section.settings.background_media != 'none'
    assign skip_contrast = true
  endif
  assign section_id = section.id

  case section.settings.content_alignment
    when 'center'
      assign vc_align = 'center'
    when 'right'
      assign vc_align = 'right'
    else
      assign vc_align = 'left'
  endcase
%}
{% render 'contrast-override',
  background_color: section.settings.background_color,
  section_id: section_id,
  skip_contrast: skip_contrast
%}

<div class="section-background color-custom-{{ section_id }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-custom-{{ section_id }}{% if section.settings.custom_css_class != blank %} {{ section.settings.custom_css_class }}{% endif %}"
  data-testid="ui-test-section"
  {% if section.settings.custom_id != blank %}
    id="{{ section.settings.custom_id }}"
  {% endif %}
  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}
  style="
    {% if section.settings.section_height == 'custom' %}
      --section-min-height: {{ section.settings.section_height_custom }}svh;
    {% elsif section.settings.section_height == 'full-screen' %}
      --section-min-height: 100svh;
    {% elsif section.settings.section_height != '' %}
      --section-min-height: var(--section-height-{{ section.settings.section_height }});
    {% endif %}

    {% if section.settings.section_height != '' %}
      --section-preview-height: 600px;
    {% endif %}

    {%- comment -%} Margin on the OUTER element; inner content wrapper uses spacing-style, so distinct ids avoid double-applying (task 10) {%- endcomment -%}
    margin-block-start: {{ section.settings.margin_top | default: 0 }}px;
    margin-block-end: {{ section.settings.margin_bottom | default: 0 }}px;
    {% render 'section-custom-width', settings: section.settings %}
  "
>
  <div class="custom-section-background">
    {% render 'background-media',
      background_media: section.settings.background_media,
      background_video: section.settings.video,
      background_video_position: section.settings.video_position,
      background_image: section.settings.background_image,
      background_image_position: section.settings.background_image_position
    %}
  </div>

  <div
    class="border-style custom-section-content"
    style="{% render 'border-override', settings: section.settings %}"
  >
    {% if section.settings.toggle_overlay %}
      {% render 'overlay', settings: section.settings, layer: '0' %}
    {% endif %}

    <div
      class="
        spacing-style
        layout-panel-flex
        layout-panel-flex--{{ section.settings.content_direction }}
        section-content-wrapper
        {% if section.settings.vertical_on_mobile %} mobile-column{% endif %}
      "
      style="
        {% render 'layout-panel-style', settings: section.settings %}
        {% render 'spacing-style', settings: section.settings %}
      "
      data-testid="section-content"
    >
      <div
        class="vape-compare"
        style="
          --vc-align: {{ vc_align }};
          --vc-head-bg: {{ section.settings.table_header_background | default: '#22402f' }};
          --vc-head-fg: {{ section.settings.table_header_text | default: '#d9b36c' }};
          gap: {{ section.settings.gap | default: 12 }}px;
        "
      >
        {%- comment -%} 1. Header: subheading / heading / description from section.settings.
          Markup mirrors Horizon's text block (snippets/text.liquid) so the theme's
          .text-block typography, spacing and preset classes apply natively. {%- endcomment -%}
        {% if section.settings.subheading != blank
          or section.settings.heading != blank
          or section.settings.description != blank
        %}
          <div class="vape-compare__header">
            {% if section.settings.subheading != blank %}
              <p class="vape-compare__eyebrow">{{ section.settings.subheading | escape }}</p>
            {% endif %}

            {% if section.settings.heading != blank %}
              <div
                class="text-block {{ section.settings.heading_preset }}"
                style="--width: 100%; --text-align: var(--vc-align);"
              >
                <h2 class="{{ section.settings.heading_preset }}">{{ section.settings.heading }}</h2>
              </div>
            {% endif %}

            {% if section.settings.description != blank %}
              <div
                class="text-block rte paragraph"
                style="--width: 100%; --text-align: var(--vc-align);"
              >
                {{ section.settings.description }}
              </div>
            {% endif %}
          </div>
        {% endif %}

        {%- comment -%} 2. Table: columns from section.settings, rows from section blocks. {%- endcomment -%}
        {% render 'vape-guide-compare-table', section: section %}

        {%- comment -%} 3. Footer: note + button from section.settings. {%- endcomment -%}
        {% if section.settings.note != blank or section.settings.button_label != blank %}
          <div class="vape-compare__footer">
            {% if section.settings.note != blank %}
              <div class="vape-compare__note rte">{{ section.settings.note }}</div>
            {% endif %}

            {% if section.settings.button_label != blank %}
              <div class="vape-compare__cta">
                <a
                  class="{{ section.settings.button_style | default: 'button' }}"
                  href="{{ section.settings.button_link | default: '#' }}"
                >
                  {{- section.settings.button_label | escape -}}
                </a>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .section-wrapper {
    --section-height-offset: 0px;
  }

  .section[data-shopify-visual-preview] {
    min-height: var(--section-preview-height);
    padding-top: 0;
  }

  .section[data-shopify-visual-preview] .custom-section-background {
    display: none;
  }

  body:has(#header-group > .header-section > #header-component[transparent]):not(
      :has(#header-group > .header-section + .shopify-section)
    )
    #MainContent
    > .section-wrapper:first-child {
    --section-height-offset: var(--header-group-height, 0);
  }

  .custom-section-background {
    grid-column: 1 / -1;
  }

  .custom-section-content {
    z-index: var(--layer-flat);
  }

  /* --- Vaporizer comparison: content layout (table styles live in the snippet) --- */
  .vape-compare {
    width: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .vape-compare__header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: var(--vc-align, left);
  }

  .vape-compare__eyebrow {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .vape-compare__footer {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .vape-compare__note {
    font-size: 16px;
    font-style: italic;
    text-align: var(--vc-align, left); 
  }

  .vape-compare__note p {
    margin: 0;
  }

  .vape-compare__cta {
    text-align: var(--vc-align, center);
  }
  .vape-compare__cta .button {
    margin: 0 auto;
  }
{% endstylesheet %}


