              ]
            },
            "accordion_row_9ngPfy": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "How often should I replace my mouthpiece or screens?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_Cqdm3t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>There's no fixed schedule, swap in a fresh mouthpiece or screen whenever you see visible wear or airflow feels restricted. Both are quick, tool-free installs, and each comes in a multi-pack so you always have a backup on hand.</p>",
                    "width": "100%",
