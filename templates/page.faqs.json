          "blocks": {
            "accordion_row_Mrdxkd": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "What is The Hippie Pipe?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_JXir7f": {
                  "type": "text",
                  "settings": {
                    "text": "<p>We design compact, analog vaporizer devices and accessories for adults who want a bold, portable, no-fuss alternative to bulky gear. No apps, no settings, just fire it up and go.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "max_width_custom": 600,
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
