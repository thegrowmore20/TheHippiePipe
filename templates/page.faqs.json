              "settings": {
                "heading": "What's included in the Pipe X Holder Bundle?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_brJNHh": {
                  "type": "text",
                  "settings": {
                    "text": "<p>The Pipe X device, a Double Jet Flame Torch Lighter, a grinder, and a matching Pipe Holder, a complete kit at a discount versus buying each item separately.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "max_width_custom": 600,
                    "alignment": "left",
                    "type_preset": "rte",
