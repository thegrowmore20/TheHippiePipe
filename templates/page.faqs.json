                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_JXir7f"
              ]
            },
            "accordion_row_LhXmx6": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "Do I need to be 21+ to order?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_wDAMhd": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Yes. All products are strictly for adult use (21+). Age verification is required at checkout, and ID may be checked at delivery depending on your state/carrier.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "max_width_custom": 600,
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_wDAMhd"
              ]
            },
            "accordion_row_rLKg3b": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "Are your products legal where I live?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_wBikm9": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Our devices are sold as tobacco/dry-herb accessories for legal adult use. Availability can vary by state or country due to local vape-accessory regulations, so check your local laws before ordering.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "max_width_custom": 600,
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "text_color": "",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_wBikm9"
              ]
            },
            "accordion_row_bTzm3K": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "Which device is right for me?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_HRncxm": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Want zero electronics and manual torch heating? Go with The Hippie Pipe, Pipe X, or OM Chrome. Prefer a rechargeable 510-thread battery setup? Check out OM Gunmetal or OM Rose Gold.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "max_width_custom": 600,
