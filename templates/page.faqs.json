            "accordion_row_3gYfn9": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "How does the Double Jet Flame Torch Lighter work?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_e4G6tc": {
                  "type": "text",
                  "settings": {
                    "text": "<p>It's a refillable butane torch with an adjustable dual-jet flame, built to pair with all our analog devices. Refill through the base valve, and keep the flame pointed away from your face and any flammable materials when lighting.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "max_width_custom": 600,
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
