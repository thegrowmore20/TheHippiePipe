              },
              "block_order": [
                "text_4g9TdL"
              ]
            },
            "accordion_row_RDgt3T": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "What does the Glass Water Bubbler + Silicone Adapter do?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_acC3fb": {
                  "type": "text",
                  "settings": {
                    "text": "<p>It attaches to your Hippie Pipe or Pipe X via the silicone adapter, routing your draw through water for a smoother, cooler pull. The glass is fragile, so handle and store it carefully when traveling.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "max_width_custom": 600,
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
