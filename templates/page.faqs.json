                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_e4G6tc"
              ]
            },
            "accordion_row_hM9LaQ": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "What's the difference between The Sprocket Grinder and The Rocket Plus?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_4g9TdL": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Both feature durable metal construction with precision-cut teeth. The Sprocket is our standard-size grinder, The Rocket Plus is a smaller keychain-attachable version for ultra-portable, on-the-go grinding.</p>",
                    "width": "100%",
                    "max_width": "none",
                    "max_width_custom": 600,
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
