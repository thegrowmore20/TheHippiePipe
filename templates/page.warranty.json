          "blocks": {
            "text_jj7kPn": {
              "type": "text",
              "name": "t:names.heading",
              "settings": {
                "text": "<h2>Warranty Terms & Details</h2>",
                "width": "fit-content",
                "max_width": "narrow",
                "max_width_custom": 600,
                "alignment": "left",
                "type_preset": "h3",
                "font": "var(--font-body--family)",
