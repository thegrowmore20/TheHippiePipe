        "accordion_dfmjGr": {
          "type": "accordion",
          "name": "t:names.accordion",
          "settings": {
            "icon": "caret",
            "dividers": true,
            "divider_color": "{{ settings.color_palette.color2 }}",
            "type_preset": "h5",
