{%- doc -%}
  Renders the product's short-form videos as a carousel of click-to-play facades.

  Reads a list-of-URLs metafield (YouTube or Vimeo) and renders a thumbnail per video.
  The thumbnail is a facade: no iframe is created until the viewer clicks, so the block
  costs one image per slide instead of an embedded player each.

  The carousel itself is the theme's slideshow component, so drag, keyboard, arrows and
  pagination all behave like every other carousel in the theme.
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign namespace = block_settings.metafield_namespace | default: 'custom'
  assign key = block_settings.metafield_key | default: 'product_short_videos'
  assign video_links = product.metafields[namespace][key].value

  # Matches the slides-per-view breakpoints in the stylesheet below.
  assign shorts_sizes = '(min-width: 990px) 22vw, (min-width: 750px) 30vw, 45vw'
-%}

{%- if video_links != blank and video_links.size > 0 -%}
  {%- comment -%}
    theme-check-disable RemoteAsset
    The thumbnails are YouTube's own stills, fetched from i.ytimg.com. They cannot be served
    from the Shopify CDN without re-uploading every frame, so the preconnect below is the
    cheapest way to shorten that handshake.
  {%- endcomment -%}
  <link rel="preconnect" href="https://i.ytimg.com" crossorigin>

  {%- capture slides -%}
    {%- assign rendered = 0 -%}
    {%- for video_url in video_links -%}
      {%- liquid
        assign video_id = ''
        assign video_type = ''
        assign is_short = false

        if video_url contains 'youtube.com' or video_url contains 'youtu.be'
          assign video_type = 'youtube'
          if video_url contains 'youtu.be/'
            assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first
          elsif video_url contains 'watch?v='
            assign video_id = video_url | split: 'watch?v=' | last | split: '&' | first
          elsif video_url contains 'embed/'
            assign video_id = video_url | split: 'embed/' | last | split: '?' | first
          elsif video_url contains 'shorts/'
            assign video_id = video_url | split: 'shorts/' | last | split: '?' | first
            assign is_short = true
          endif
        elsif video_url contains 'vimeo.com'
          assign video_type = 'vimeo'
          assign video_id = video_url | split: 'vimeo.com/' | last | split: '/' | first | split: '?' | first
        endif
      -%}

      {%- if video_id != blank -%}
        {%- capture slide_children -%}
          <button
            type="button"
            class="shorts__facade"
            data-video-id="{{ video_id }}"
            data-video-type="{{ video_type }}"
            aria-label="{{ 'content.shorts_play_video' | t: index: forloop.index }}"
          >
            {%- if block_settings.cover_image != blank -%}
              {{
                block_settings.cover_image
                | image_url: width: 720
                | image_tag:
                  widths: '405, 540, 720',
                  sizes: shorts_sizes,
                  class: 'shorts__thumb',
                  loading: 'lazy',
                  alt: ''
              }}
            {%- elsif video_type == 'youtube' -%}
              {%- comment -%}
                Shorts are 9:16, so try the portrait still (oar2) before the 4:3 hqdefault —
                that avoids cropping a landscape frame into a portrait slide.
              {%- endcomment -%}
              <img
                class="shorts__thumb"
                src="https://i.ytimg.com/vi/{{ video_id }}/{% if is_short %}oar2{% else %}hqdefault{% endif %}.jpg"
                onerror="if(!this.dataset.f){this.dataset.f='1';this.src='https://i.ytimg.com/vi/{{ video_id }}/hqdefault.jpg';}"
                width="405"
                height="720"
                loading="lazy"
                decoding="async"
                fetchpriority="{% if forloop.first %}high{% else %}low{% endif %}"
                sizes="{{ shorts_sizes }}"
                draggable="false"
                alt=""
              >
            {%- endif -%}
            <span class="shorts__play" aria-hidden="true">
              <svg viewBox="0 0 68 48" xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z"
                  fill="{{ block_settings.play_button_color }}"
                ></path>
                <path d="M45 24 27 14v20z" fill="#ffffff"></path>
              </svg>
            </span>
          </button>
        {%- endcapture -%}
        {%- comment -%} theme-check-enable RemoteAsset {%- endcomment -%}

        {%- render 'slideshow-slide',
          index: rendered,
          children: slide_children,
          class: 'shorts__slide',
          slide_id: video_id
        -%}
        {%- assign rendered = rendered | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if rendered > 0 -%}
    {%- liquid
      # Arrows and pagination only earn their place when the slides actually overflow. The
      # slide count is known here, so each breakpoint gets a flag rather than a JS measure.
      assign fits_classes = ''
      if rendered <= block_settings.slides_mobile
        assign fits_classes = fits_classes | append: ' shorts--fits-mobile'
      endif
      if rendered <= block_settings.slides_medium
        assign fits_classes = fits_classes | append: ' shorts--fits-tablet'
      endif
      if rendered <= block_settings.slides_desktop
        assign fits_classes = fits_classes | append: ' shorts--fits-desktop'
      endif
    -%}

    {%- capture controls -%}
      {%- render 'slideshow-controls',
        style: block_settings.pagination_style,
        item_count: rendered,
        show_arrows: false,
        pagination_position: 'center'
      -%}
    {%- endcapture -%}

    {%- comment -%}
      The heading lives inside this guard, so a product with no shorts renders nothing at
      all rather than a heading over empty space.
    {%- endcomment -%}
    <div
      class="shorts-block spacing-style"
      style="{% render 'spacing-style', settings: block_settings %}"
      {{ block.shopify_attributes }}
    >
      {% content_for 'block', type: '_heading', id: 'shorts-heading' %}

      <product-shorts
        class="shorts{{ fits_classes }}"
        style="
        --shorts-columns: {{ block_settings.slides_desktop }};
        --shorts-columns-tablet: {{ block_settings.slides_medium }};
        --shorts-columns-mobile: {{ block_settings.slides_mobile }};
        --shorts-gap: {{ block_settings.slide_gap }}px;
        --slideshow-gap: {{ block_settings.slide_gap }}px;
        --shorts-radius: {{ block_settings.video_border_radius }}px;
        --shorts-play-size: {{ block_settings.play_button_size }}px;
        --shorts-muted: {{ block_settings.muted }};
        "
      >
        {%- render 'slideshow',
          class: 'shorts__slideshow',
          slides: slides,
          slide_count: rendered,
          controls: controls,
          show_arrows: block_settings.show_arrows,
          icon_style: block_settings.icons_style,
          icon_shape: block_settings.icons_shape,
          infinite: false
        -%}
      </product-shorts>
    </div>

    <script>
      if (!customElements.get('product-shorts')) {
        customElements.define(
          'product-shorts',
          class ProductShorts extends HTMLElement {
            connectedCallback() {
              this.muted = this.style.getPropertyValue('--shorts-muted').trim() === 'true';
              this.addEventListener('click', (event) => {
                const facade = event.target.closest('.shorts__facade');
                if (facade) this.play(facade);
              });
            }

            play(facade) {
              const id = facade.dataset.videoId;
              if (!id) return;

              // Only one video plays per carousel; opening another tears the previous one down.
              this.stop();

              const params = this.muted ? 'autoplay=1&mute=1&muted=1&' : 'autoplay=1&';
              const src =
                facade.dataset.videoType === 'vimeo'
                  ? 'https://player.vimeo.com/video/' + id + '?' + params
                  : 'https://www.youtube.com/embed/' + id + '?' + params + 'playsinline=1&rel=0&modestbranding=1';

              const iframe = document.createElement('iframe');
              iframe.className = 'shorts__player';
              iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
              iframe.allowFullscreen = true;
              iframe.title = facade.getAttribute('aria-label') || '';
              iframe.src = src;

              facade.hidden = true;
              facade.parentElement.appendChild(iframe);
              this.activeFacade = facade;
            }

            stop() {
              if (!this.activeFacade) return;
              const player = this.activeFacade.parentElement.querySelector('.shorts__player');
              if (player) player.remove();
              this.activeFacade.hidden = false;
              this.activeFacade = null;
            }

            disconnectedCallback() {
              this.stop();
            }
          }
        );
      }
    </script>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .shorts-block {
    display: block;
    width: 100%;
  }

  .shorts {
    display: block;
    width: 100%;
  }

  /*
   * Nothing to navigate to when every slide is already on screen, so drop the arrows and
   * the pagination, and centre the slides in the track instead of leaving them packed
   * against the start. The .shorts--fits-* flags come from comparing the slide count
   * against the columns configured for each breakpoint.
   *
   * Centring is deliberately scoped to the fits case: `justify-content: center` on a
   * scroll container makes the overflowing start unreachable, which would break the
   * carousel the moment the slides no longer fit.
   */
  @media screen and (max-width: 749px) {
    .shorts--fits-mobile slideshow-arrows,
    .shorts--fits-mobile slideshow-controls {
      display: none;
    }

    .shorts--fits-mobile slideshow-slides {
      justify-content: center;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .shorts--fits-tablet slideshow-arrows,
    .shorts--fits-tablet slideshow-controls {
      display: none;
    }

    .shorts--fits-tablet slideshow-slides {
      justify-content: center;
    }
  }

  @media screen and (min-width: 990px) {
    .shorts--fits-desktop slideshow-arrows,
    .shorts--fits-desktop slideshow-controls {
      display: none;
    }

    .shorts--fits-desktop slideshow-slides {
      justify-content: center;
    }
  }

  /*
   * Slides-per-view is driven by --slide-width, which the theme's slideshow-slide
   * already reads. Subtracting the gaps keeps the requested column count exact.
   */
  .shorts__slide {
    --slide-width: calc(
      (100% - (var(--shorts-columns-mobile) - 1) * var(--shorts-gap)) / var(--shorts-columns-mobile)
    );

    aspect-ratio: 9 / 16;
    border-radius: var(--shorts-radius);
    background-color: var(--palette-darkest, #000);
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .shorts__slide {
      --slide-width: calc(
        (100% - (var(--shorts-columns-tablet) - 1) * var(--shorts-gap)) / var(--shorts-columns-tablet)
      );
    }
  }

  @media screen and (min-width: 990px) {
    .shorts__slide {
      --slide-width: calc((100% - (var(--shorts-columns) - 1) * var(--shorts-gap)) / var(--shorts-columns));
    }
  }

  .shorts__facade {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .shorts__thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    user-select: none;
  }

  .shorts__play {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: var(--shorts-play-size);
    aspect-ratio: 1;
    opacity: 0.95;
    pointer-events: none;
    transition: scale var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .shorts__play svg {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(0 1px 4px rgb(0 0 0 / 0.45));
  }

  .shorts__facade:hover .shorts__play {
    scale: 1.08;
  }

  .shorts__player {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Shorts",
  "tag": null,
  "blocks": [
    {
      "type": "_heading"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Metafield"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key",
      "default": "product_short_videos"
    },
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Fallback cover image",
      "info": "Used for Vimeo videos. YouTube thumbnails are fetched automatically per video."
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Start muted",
      "default": false
    },
    {
      "type": "range",
      "id": "play_button_size",
      "label": "Play button size",
      "min": 40,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 68
    },
    {
      "type": "color",
      "id": "play_button_color",
      "label": "Play button color",
      "default": "#FF0000"
    },
    {
      "type": "range",
      "id": "video_border_radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "label": "Slides on desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "slides_medium",
      "label": "Slides on tablet",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "slides_mobile",
      "label": "Slides on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "slide_gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "t:content.navigation"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icons",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.large_arrows"
        },
        {
          "value": "chevron_large",
          "label": "t:options.large_chevrons"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ block.settings.show_arrows }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "circle",
      "visible_if": "{{ block.settings.show_arrows }}"
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "t:settings.pagination",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "dots",
          "label": "t:options.dots"
        },
        {
          "value": "counter",
          "label": "t:options.counter"
        }
      ],
      "default": "dots"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Shorts",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
