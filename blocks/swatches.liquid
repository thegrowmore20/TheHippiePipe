

{%- liquid
  assign block_settings = block.settings
  assign product_has_swatches = false

  for product_option in closest.product.options_with_values
    assign swatch_count = product_option.values | map: 'swatch' | compact | size

    if swatch_count > 0
      assign product_has_swatches = true
    endif
  endfor

  # No swatch data from Shopify: fall back to variant images where possible.
  unless product_has_swatches
    assign first_option = closest.product.options_with_values.first

    capture swatch_image_fallback
      render 'swatch-fallback-check', product_option: first_option, product_resource: closest.product
    endcapture

    if swatch_image_fallback contains 'true'
      assign product_has_swatches = true
    endif
  endunless
-%}

{% stylesheet %}
  product-swatches {
    width: 100%;
    display: flex;
    position: relative;
    overflow: hidden;
    gap: 0;
    flex-shrink: 0;
  }

  /*
   * Overlay mode. The swatches are reparented into the card's .card-gallery (which is
   * already position:relative + overflow:hidden — the same container the theme floats the
   * sale badge over), so these rules only take effect once that move has happened. Until
   * then the element stays in .product-card__content and renders in normal flow, which is
   * the graceful fallback when JS is off.
   */
  .card-gallery > product-swatches.product-swatches--overlay {
    position: absolute;
    inset-block-end: var(--product-swatches-overlay-inset, 0.5rem);
    inset-inline-start: var(--product-swatches-overlay-inset, 0.125rem);
    z-index: 2;
    width: auto;
    max-width: calc(100% - var(--product-swatches-overlay-inset, 0.125rem) * 2);
    margin: 0;
    overflow: visible;
    /* Empty regions of the strip must not swallow clicks meant for the product link. */
    pointer-events: none;
  }

  .card-gallery > product-swatches.product-swatches--overlay :is(label, button, input, a) {
    pointer-events: auto;
  }
{% endstylesheet %}

{% if product_has_swatches and settings.show_card_swatches %}
  <product-swatches
    class="{% if block_settings.overlay_on_media %}product-swatches--overlay{% endif %}"
    {% if block_settings.overlay_on_media %}data-overlay-on-media{% endif %}
    data-product-id="{{ closest.product.id }}"
    data-product-url="{{ closest.product.url }}"
    style="
      --overflow-list-alignment: {{ block_settings.product_swatches_alignment }};
      --overflow-list-alignment-mobile: {{ block_settings.product_swatches_alignment_mobile }};
      --product-swatches-alignment: {% if block_settings.product_swatches_alignment == 'flex-start' %}start{% elsif block_settings.product_swatches_alignment == 'flex-end' %}end{% else %}center{% endif %};
      --product-swatches-alignment-mobile: {% if block_settings.product_swatches_alignment_mobile == 'flex-start' %}start{% elsif block_settings.product_swatches_alignment_mobile == 'flex-end' %}end{% else %}center{% endif %};
      --product-swatches-padding-block-start: {{ block_settings.product_swatches_padding_top }}px;
      --product-swatches-padding-block-end: {{ block_settings.product_swatches_padding_bottom }}px;
      --product-swatches-padding-inline-start: {{ block_settings.product_swatches_padding_left }}px;
      --product-swatches-padding-inline-end: {{ block_settings.product_swatches_padding_right }}px;
    "
    {{ block.shopify_attributes }}
  >
    {% render 'variant-swatches', product_resource: closest.product %}
  </product-swatches>

  {% comment %} {%- if block_settings.overlay_on_media -%}
    <script>
      if (!customElements.get('product-swatches')) {
        customElements.define(
          'product-swatches',
          class ProductSwatches extends HTMLElement {
            connectedCallback() {
              if (!this.hasAttribute('data-overlay-on-media') || this.dataset.placed) return;

              // Move into the card's media so absolute positioning is measured against the
              // image, not the whole card column. Runs during parse, before paint, so the
              // swatches never flash in their in-flow position first.
              const gallery = this.closest('.product-card__content')?.querySelector('.card-gallery');
              if (gallery && !gallery.contains(this)) {
                gallery.appendChild(this);
                this.dataset.placed = 'true';
              }
            }
          }
        );
      }
    </script>
  {%- endif -%} {% endcomment %}
{% endif %}

{% schema %}
{
  "name": "t:names.swatches",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_swatches"
    },
    {
      "type": "checkbox",
      "id": "overlay_on_media",
      "label": "Overlay on image",
      "default": true,
      "info": "Places the swatches in the bottom-left corner of the product image instead of below it."
    },
    {
      "type": "select",
      "id": "product_swatches_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "product_swatches_alignment_mobile",
      "label": "t:settings.alignment_mobile",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "header",
      "content": "t:content.padding",
      "visible_if": "{{ block.settings.hide_padding == false }}"
    },
    {
      "type": "checkbox",
      "id": "hide_padding",
      "label": "t:settings.hide_padding",
      "default": false,
      "visible_if": "{{ false }}"
    },
    {
      "type": "range",
      "id": "product_swatches_padding_top",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 4,
      "visible_if": "{{ block.settings.hide_padding == false }}"
    },
    {
      "type": "range",
      "id": "product_swatches_padding_bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.hide_padding == false }}"
    },
    {
      "type": "range",
      "id": "product_swatches_padding_left",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.hide_padding == false }}"
    },
    {
      "type": "range",
      "id": "product_swatches_padding_right",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.hide_padding == false }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.swatches",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
