

{% assign product = closest.product %}

{% capture children %}
  {% unless product == blank %}
    {%- liquid
      # Savings shown on the sale badge. Prefer the variant the card actually prices so the
      # badge agrees with the visible strikethrough; fall back to the product-level values
      # that gate the badge itself.
      assign badge_variant = product.selected_or_first_available_variant
      assign badge_savings = badge_variant.compare_at_price | minus: badge_variant.price
      if badge_savings <= 0
        assign badge_savings = product.compare_at_price | minus: product.price
      endif
      assign badge_savings_money = badge_savings | money
    -%}
    {%- if product.available == false or product.compare_at_price > product.price -%}
      <div
        class="product-badges product-badges--{{ settings.badge_position }}"
        style="
            --badge-border-radius: {{ settings.badge_corner_radius }}px;
            --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};
        "
      >
        <div
          class="
            product-badges__badge product-badges__badge--rectangle
            {% if product.available == false %} color-custom-badge-sold-out{% elsif product.compare_at_price > product.price %} color-custom-badge-sale{% endif %}
          "
        >
          {%- if product.available == false -%}
            {{ 'content.product_badge_sold_out' | t }}
          {%- elsif product.compare_at_price > product.price -%}
            {%- if badge_savings > 0 -%}
              {{ 'content.product_badge_save' | t: amount: badge_savings_money }}
            {%- else -%}
              {{ 'content.product_badge_sale' | t }}
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    {%- comment -%}
      Overlay (hover) quick-add intentionally removed from product cards for performance:
      the always-visible inline Quick add block below the price is the sole card CTA, so the
      card no longer renders the quick-add component twice. (Featured-product and hotspot
      surfaces keep their own overlay quick-add.)
    {%- endcomment -%}
    {%- comment -%} Variant swatches overlaid bottom-left on the media (task 6) {%- endcomment -%}
    {%- if block.settings.show_variant_swatches -%}
      {%- liquid
        assign product_has_swatches = false
        for option in product.options_with_values
          assign option_swatch_count = option.values | map: 'swatch' | compact | size
          if option_swatch_count > 0
            assign product_has_swatches = true
            break
          endif
        endfor
      -%}
      {%- if product_has_swatches -%}
        <div class="product-card-swatches-overlay">
          {% render 'variant-swatches', product_resource: product %}
        </div>
      {%- endif -%}
    {%- endif -%}
  {% endunless %}
{% endcapture %}

{% render 'card-gallery', children: children %}

{% # Title and price for the zoomed out grid view %}
<div class="product-grid-view-zoom-out--details">
  {% if product == blank %}
    <h3 class="h4">{{ 'content.product_card_placeholder' | t }}</h3>
  {% else %}
    <h3 class="h4">{{ product.title }}</h3>
  {% endif %}
</div>

{% render 'product-card-gallery-zoom-details-styles' %}
{% render 'product-badges-styles' %}

{% stylesheet %}
  /* Variant swatches overlaid on the bottom-left of the card media (task 6) */
  .product-card-swatches-overlay {
    position: absolute;
    inset-block-end: var(--padding-sm);
    inset-inline-start: var(--padding-sm);
    z-index: var(--layer-raised);
    max-width: calc(100% - 2 * var(--padding-sm));
    pointer-events: auto;
  }

  .product-card-swatches-overlay swatches-variant-picker-component {
    width: auto;
    --product-swatches-alignment: flex-start;
    --product-swatches-alignment-mobile: flex-start;
  }

  /* Hide the overlay in the zoomed-out grid view alongside the other card overlays */
  [product-grid-view='zoom-out'] .card-gallery > .product-card-swatches-overlay {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_image",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "portrait",
      "label": "t:settings.aspect_ratio",
      "info": "t:info.aspect_ratio_adjusted"
    },
    {
      "type": "checkbox",
      "id": "show_variant_swatches",
      "label": "t:settings.show_variant_swatches",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_card_media",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
